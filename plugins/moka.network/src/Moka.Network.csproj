<Project Sdk="Microsoft.NET.Sdk.Razor">

	<!--
		Network Toolkit for Mokaterm: one app tool with DNS lookup, ping, a TCP port check, traceroute, whois, Wake-on-LAN
		and a subnet calculator, plus a settings page for the defaults. The network logic lives in plain classes (Lookup,
		Echo, Ports, Whois, Wake, Subnets), which the views go through and the tests cover; the DNS client is written here,
		so the plugin brings no package of its own. Every build writes
		bin/<configuration>/net10.0/moka.network-<version>.mokaplugin.
	-->
	<PropertyGroup>
		<AssemblyName>Moka.Network</AssemblyName>
		<RootNamespace>Moka.Network</RootNamespace>
		<Version>1.0.0</Version>
	</PropertyGroup>

	<PropertyGroup>
		<MokatermPluginId>moka.network</MokatermPluginId>
		<MokatermPluginName>Network Toolkit</MokatermPluginName>
		<MokatermPluginPublisher>Moka</MokatermPluginPublisher>
		<MokatermPluginDescription>DNS lookup, ping, TCP port check, traceroute, whois, Wake-on-LAN and a subnet calculator in one tool.</MokatermPluginDescription>
		<MokatermPluginHosts>desktop;web</MokatermPluginHosts>
		<MokatermPluginPackOnBuild>true</MokatermPluginPackOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Mokaterm.UI.Common" />
		<PackageReference Include="Mokaterm.Plugin.Sdk" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Moka.Network.Tests" />
	</ItemGroup>

</Project>
