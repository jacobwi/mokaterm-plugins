@inherits SessionSectionBase
@using Moka.Network.Server

<NetworkPage Title="Capture" Said="@Summary">
	<Actions>
		<Hint Text="@PrimaryTitle">
			<MokaButton Variant="MokaVariant.Filled"
						Color="MokaColor.Primary"
						Size="MokaSize.Sm"
						StartIcon="@(Capturing ? NetworkIcons.Stop : NetworkIcons.Capture)"
						Disabled="@(Busy && !Capturing)"
						OnClick="PrimaryAsync">@PrimaryText</MokaButton>
		</Hint>
	</Actions>
	<Origin>
		<SessionOriginNote Session="Session" />
	</Origin>
	<ChildContent>
		<MokaCard Inner Outlined Title="Filter">
			<MokaFlexbox Gap="MokaSpacingScale.Sm">
				<div @onkeydown="OnKeyAsync">
					<MokaGrid ColumnsValue="minmax(160px, 3fr) minmax(90px, 1fr)" Gap="MokaSpacingScale.Sm">
						<MokaTextField Label="Host" Value="@_host" ValueChanged="@(value => _host = value ?? "")" Placeholder="any host, or example.com" Size="MokaSize.Sm" spellcheck="false" autocomplete="off" Disabled="Capturing" />
						<MokaTextField Label="Port" Value="@_port" ValueChanged="@(value => _port = value ?? "")" Placeholder="any" Size="MokaSize.Sm" inputmode="numeric" autocomplete="off" Disabled="Capturing" />
					</MokaGrid>
				</div>
				<MokaFieldWrapper Label="Protocol" CustomControl Size="MokaSize.Sm">
					<EnumSegmentedControl TEnum="CaptureProtocol" Value="_protocol" ValueChanged="@(value => _protocol = value)" Options="Protocols" AriaLabel="Protocol" Disabled="Capturing" />
				</MokaFieldWrapper>
				<MokaCaption>Three fields, nothing more: tcpdump gets no free-text expression, so a capture cannot be pointed anywhere but these.</MokaCaption>
			</MokaFlexbox>
		</MokaCard>

		@if (_error is { } error)
		{
			<MokaAlert Severity="MokaToastSeverity.Error" Dense>@error</MokaAlert>
		}
		@if (_absent)
		{
			<MokaAlert Severity="MokaToastSeverity.Info" Dense>This server has no tcpdump, so nothing can be captured here.</MokaAlert>
		}
		else if (_refused is { } refused)
		{
			<MokaAlert Severity="MokaToastSeverity.Error" Dense>@refused</MokaAlert>
		}

		@if (Capturing && _rows.Count == 0)
		{
			<RunningCard Text="@($"Capturing {_filter}: waiting for the first packet")" />
		}

		@if (_rows.Count > 0 || _lines.Total > 0)
		{
			<CaptureView Rows="_rows" Total="_lines.Total" Dropped="_lines.Dropped" Filter="@(Capturing ? _filter : "")" AllText="@(_rows.Count > 0 ? _lines.AllText() : "")" />
		}
		else if (!Capturing)
		{
			<MokaEmptyState Icon="NetworkIcons.Capture"
							Title="See the packets the server sends and receives"
							Description="@(_probed ? "Start a capture to see the packets the server sends and receives. tcpdump needs root on most servers." : "Asking the server what it has.")"
							Compact />
		}
	</ChildContent>
</NetworkPage>
