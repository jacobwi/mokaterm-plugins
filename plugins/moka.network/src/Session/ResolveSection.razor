@inherits SessionSectionBase
@using Moka.Network.Server

<NetworkPage Title="Resolve" Said="@Summary">
	<Actions>
		<Hint Text="@PrimaryTitle">
			<MokaButton Variant="MokaVariant.Filled"
						Color="MokaColor.Primary"
						Size="MokaSize.Sm"
						StartIcon="@(Running ? NetworkIcons.Stop : NetworkIcons.Start)"
						Disabled="@(Busy && !Running)"
						OnClick="PrimaryAsync">@PrimaryText</MokaButton>
		</Hint>
	</Actions>
	<Origin>
		<SessionOriginNote Session="Session" />
	</Origin>
	<ChildContent>
		<MokaGrid MinColumn="400px" Gap="MokaSpacingScale.Md">
			<MokaCard Inner Outlined Title="Name or address">
				<MokaFlexbox Gap="MokaSpacingScale.Sm">
					<div @onkeydown="OnKeyAsync">
						<MokaTextField Label="Host"
									   Value="@_host"
									   ValueChanged="@(value => _host = value ?? "")"
									   Placeholder="example.com or 192.0.2.10"
									   HelperText="An address asks for its name; a name asks for the addresses the server sees."
									   Size="MokaSize.Sm"
									   spellcheck="false"
									   autocomplete="off"
									   Disabled="NotReady" />
					</div>
				</MokaFlexbox>
			</MokaCard>
			@if (_nameservers.Count > 0)
			{
				<MokaCard Inner Outlined Title="The server asks these resolvers" Subtitle="From its /etc/resolv.conf">
					<MokaFlexbox Gap="MokaSpacingScale.Sm">
						<MokaFlexbox Direction="MokaDirection.Row" Wrap GapValue="6px">
							@for (int index = 0; index < _nameservers.Count; index++)
							{
								int server = index;
								<MokaTag Text="@_nameservers[server].ToString()" Color="MokaColor.Info" @key="server" />
							}
						</MokaFlexbox>
					</MokaFlexbox>
				</MokaCard>
			}
		</MokaGrid>

		@if (_error is { } error)
		{
			<MokaAlert Severity="MokaToastSeverity.Error" Dense>@error</MokaAlert>
		}
		@if (Offline)
		{
			<MokaAlert Severity="MokaToastSeverity.Info" Dense>The session is not connected. Reconnect it to ask its server again.</MokaAlert>
		}
		@if (_absent)
		{
			<MokaAlert Severity="MokaToastSeverity.Info" Dense>This server has no getent, so its resolver cannot be asked this way.</MokaAlert>
		}

		@if (Running)
		{
			<RunningCard Text="@(_target ?? "Asking the server")" />
		}
		else if (_target is { } target)
		{
			<GetentAnswerView Target="@target" Rows="_rows" Reverse="_reverse" />
		}
		else if (Connected && !_absent && _error is null)
		{
			<MokaEmptyState Icon="NetworkIcons.Dns"
							Title="Ask the server's own resolver"
							Description="getent hosts on the server, so the answer is what the server sees: its hosts file, its search domains and its resolvers."
							Compact />
		}
	</ChildContent>
</NetworkPage>
