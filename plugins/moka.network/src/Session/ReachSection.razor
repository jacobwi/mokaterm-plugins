@inherits SessionSectionBase
@using Moka.Network.Server

<NetworkPage Title="Reach" Said="@Summary">
	<Actions>
		<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm" StartIcon="NetworkIcons.Ping" Disabled="@(!CanPing)" OnClick="PingAsync">Ping</MokaButton>
		<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm" StartIcon="NetworkIcons.Trace" Disabled="@(!CanTrace)" OnClick="TraceAsync">Trace</MokaButton>
		<Hint Text="@PrimaryTitle">
			<MokaButton Variant="MokaVariant.Filled"
						Color="MokaColor.Primary"
						Size="MokaSize.Sm"
						StartIcon="@(Running ? NetworkIcons.Stop : NetworkIcons.Port)"
						Disabled="@(Busy && !Running)"
						OnClick="PrimaryAsync">@PrimaryText</MokaButton>
		</Hint>
	</Actions>
	<Origin>
		<SessionOriginNote Session="Session" />
	</Origin>
	<ChildContent>
		<MokaCard Inner Outlined Title="Target">
			<MokaFlexbox Gap="MokaSpacingScale.Sm">
				<div @onkeydown="OnKeyAsync">
					<MokaGrid ColumnsValue="minmax(160px, 3fr) repeat(3, minmax(72px, 1fr))" Gap="MokaSpacingScale.Sm">
						<MokaTextField Label="Host" Value="@_host" ValueChanged="@(value => _host = value ?? "")" Placeholder="example.com or 192.0.2.10" Size="MokaSize.Sm" spellcheck="false" autocomplete="off" Disabled="@(!Connected)" />
						<MokaTextField Label="Port" Value="@_port" ValueChanged="@(value => _port = value ?? "")" Placeholder="443" Size="MokaSize.Sm" inputmode="numeric" autocomplete="off" />
						<MokaTextField Label="Wait (s)" Value="@_seconds" ValueChanged="@(value => _seconds = value ?? "")" Placeholder="5" Size="MokaSize.Sm" inputmode="numeric" autocomplete="off" />
						<MokaTextField Label="Pings" Value="@_count" ValueChanged="@(value => _count = value ?? "")" Placeholder="4" Size="MokaSize.Sm" inputmode="numeric" autocomplete="off" />
					</MokaGrid>
				</div>
				<MokaCaption>Check opens TCP to the port; ping sends ICMP echo; trace walks the path with @(HasTracePath ? "tracepath" : HasTraceroute ? "traceroute" : "tracepath or traceroute").</MokaCaption>
			</MokaFlexbox>
		</MokaCard>

		@if (_error is { } error)
		{
			<MokaAlert Severity="MokaToastSeverity.Error" Dense>@error</MokaAlert>
		}
		@if (Offline)
		{
			<MokaAlert Severity="MokaToastSeverity.Info" Dense>The session is not connected. Reconnect it to reach out from the server again.</MokaAlert>
		}

		@if (Running)
		{
			<RunningCard Text="Waiting for the server" />
		}

		@if (_tcp is not null || _pingText.Length > 0 || _traceText.Length > 0)
		{
			<ReachResultView TcpTarget="@_tcpTarget"
							 Tcp="_tcp"
							 PingTarget="@_pingTarget"
							 PingText="@_pingText"
							 TraceTarget="@_traceTarget"
							 TraceText="@_traceText"
							 Tracer="@_tracer" />
		}
		else if (!Busy && _error is null && Connected)
		{
			<MokaEmptyState Icon="NetworkIcons.Trace"
							Title="Can the server reach a host"
							Description="A TCP check, a ping and the path, each run on the server, so a firewall or a route on that side shows up as what it is."
							Compact />
		}
	</ChildContent>
</NetworkPage>
