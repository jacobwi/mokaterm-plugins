@inherits SessionSectionBase
@using Moka.Network.Server

<NetworkPage Title="Listening ports" Said="@Summary">
	<Actions>
		<Hint Text="@PrimaryTitle">
			<MokaButton Variant="MokaVariant.Outlined"
						Size="MokaSize.Sm"
						StartIcon="@(Running ? NetworkIcons.Stop : MokaIcons.Action.Refresh)"
						Disabled="@(Busy && !Running)"
						OnClick="PrimaryAsync">@(Running ? "Stop" : "Read again")</MokaButton>
		</Hint>
	</Actions>
	<Origin>
		<SessionOriginNote Session="Session" />
	</Origin>
	<ChildContent>
		<MokaCaption>From ss -tulpn on the server: tcp and udp, numbers only, no name lookups.</MokaCaption>

		@if (_error is { } error)
		{
			<MokaAlert Severity="MokaToastSeverity.Error" Dense>@error</MokaAlert>
		}
		@if (Offline)
		{
			<MokaAlert Severity="MokaToastSeverity.Info" Dense>The session is not connected. Reconnect it to read the server again.</MokaAlert>
		}
		@if (_absent)
		{
			<MokaAlert Severity="MokaToastSeverity.Info" Dense>This server has no ss (the iproute2 tools), so its listening ports cannot be listed here.</MokaAlert>
		}

		@if (_rows.Count > 0)
		{
			<ListeningPortsView Rows="_rows" />
		}
		else if (Busy)
		{
			<RunningCard Text="Reading the server's listening sockets" />
		}
		else if (_probed && _hasSs && _error is null && Connected)
		{
			<MokaEmptyState Icon="NetworkIcons.Port"
							Title="Nothing is listening"
							Description="Nothing is listening on the server, or ss printed nothing this account may see."
							Compact />
		}
	</ChildContent>
</NetworkPage>
