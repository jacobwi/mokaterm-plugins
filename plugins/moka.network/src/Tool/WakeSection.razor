@inherits NetworkViewBase
@using Moka.Network.Wake

<NetworkPage Title="Wake-on-LAN" Said="@Summary">
	<Actions>
		<MokaButton Variant="MokaVariant.Filled"
					Color="MokaColor.Primary"
					Size="MokaSize.Sm"
					StartIcon="NetworkIcons.Send"
					Disabled="Busy"
					OnClick="SendAsync">Send</MokaButton>
	</Actions>
	<Origin>
		<OriginNote />
	</Origin>
	<ChildContent>
		<MokaCard Inner Outlined Title="Magic packet">
			<MokaFlexbox Gap="MokaSpacingScale.Sm">
				<div @onkeydown="OnKeyAsync">
					<MokaGrid MinColumn="240px" Gap="MokaSpacingScale.Sm">
						<MokaTextField Label="MAC address" Value="@_mac" ValueChanged="@(value => _mac = value ?? "")" Placeholder="00:11:22:33:44:55" Size="MokaSize.Sm" spellcheck="false" autocomplete="off" />
						<MokaTextField Label="Send to" Value="@_target" ValueChanged="@(value => _target = value ?? "")" Placeholder="255.255.255.255, 192.168.1.255 or 192.168.1.0/24" Size="MokaSize.Sm" spellcheck="false" autocomplete="off" />
					</MokaGrid>
				</div>
				<MokaFieldWrapper Label="UDP port" CustomControl Size="MokaSize.Sm">
					<EnumSegmentedControl TEnum="WakePort" Value="_port" ValueChanged="@(value => _port = value)" Options="Ports" AriaLabel="UDP port" Disabled="Busy" />
				</MokaFieldWrapper>
				<MokaCaption>The magic packet goes out on the network @Origin is on. Routers do not pass a broadcast to other networks unless set up to, so a machine elsewhere needs its subnet's broadcast and a router that forwards it.</MokaCaption>
			</MokaFlexbox>
		</MokaCard>

		@if (_error is { } error)
		{
			<MokaAlert Severity="MokaToastSeverity.Error" Dense>@error</MokaAlert>
		}

		@if (_sent is { } sent)
		{
			<WakeResultView Sent="sent" />
		}
		else if (_error is null)
		{
			<MokaEmptyState Icon="NetworkIcons.Wake"
							Title="Wake a machine"
							Description="A magic packet to a sleeping machine's MAC address, broadcast on the network or sent to a subnet. Nothing is kept once the tool closes."
							Compact />
		}
	</ChildContent>
</NetworkPage>
