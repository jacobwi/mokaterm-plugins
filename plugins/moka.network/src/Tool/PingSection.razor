@inherits NetworkViewBase
@using Moka.Network.Echo

<NetworkPage Title="Ping" Said="@Summary">
	<Actions>
		<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm" StartIcon="NetworkIcons.Mtu" Disabled="Busy" OnClick="MtuAsync">Find path MTU</MokaButton>
		<MokaButton Variant="MokaVariant.Filled"
					Color="MokaColor.Primary"
					Size="MokaSize.Sm"
					StartIcon="@(Running ? NetworkIcons.Stop : NetworkIcons.Start)"
					Disabled="@(Busy && !Running)"
					OnClick="PrimaryAsync">@(Running ? "Stop" : "Start")</MokaButton>
	</Actions>
	<Origin>
		<OriginNote />
	</Origin>
	<ChildContent>
		<div @onkeydown="OnKeyAsync">
			<MokaGrid MinColumn="400px" Gap="MokaSpacingScale.Md">
				<MokaCard Inner Outlined Title="Target">
					<MokaFlexbox Gap="MokaSpacingScale.Sm">
						<MokaTextField Label="Host" Value="@_host" ValueChanged="@(value => _host = value ?? "")" Placeholder="example.com or 192.0.2.10" Size="MokaSize.Sm" spellcheck="false" autocomplete="off" />
						<MokaFieldWrapper Label="Address family" CustomControl Size="MokaSize.Sm">
							<EnumSegmentedControl TEnum="AddressChoice" Value="_choice" ValueChanged="@(value => _choice = value)" Options="AddressChoices.Options" AriaLabel="Address family" Disabled="Busy" />
						</MokaFieldWrapper>
						<RecentTargetsBar OnPick="@(value => _host = value)" />
					</MokaFlexbox>
				</MokaCard>
				<MokaCard Inner Outlined Title="Requests">
					<MokaFlexbox Gap="MokaSpacingScale.Sm">
						<MokaFieldWrapper Label="Request kind" CustomControl Size="MokaSize.Sm">
							<EnumSegmentedControl TEnum="PingMode" Value="_mode" ValueChanged="@(value => _mode = value)" Options="PingModeChoices.Options" AriaLabel="Request kind" Disabled="Busy" />
						</MokaFieldWrapper>
						<MokaGrid MinColumn="100px" Gap="MokaSpacingScale.Sm">
							<MokaTextField Label="Count" Value="@_count" ValueChanged="@(value => _count = value ?? "")" Placeholder="4" Size="MokaSize.Sm" inputmode="numeric" autocomplete="off" Disabled="_continuous" />
							<MokaTextField Label="Every (s)" Value="@_interval" ValueChanged="@(value => _interval = value ?? "")" Placeholder="1" Size="MokaSize.Sm" inputmode="decimal" autocomplete="off" />
							<MokaTextField Label="Wait (ms)" Value="@_timeout" ValueChanged="@(value => _timeout = value ?? "")" Size="MokaSize.Sm" inputmode="numeric" autocomplete="off" />
							<PingShapeField Mode="_mode" Size="@_size" SizeChanged="@(value => _size = value)" Port="@_port" PortChanged="@(value => _port = value)" Disabled="Busy" />
						</MokaGrid>
						<MokaCheckbox Label="Until stopped" Value="_continuous" ValueChanged="@(value => _continuous = value)" />
						@if (_mode == PingMode.Tcp)
						{
							<MokaCaption>Size is an ICMP idea: a TCP probe is one connection attempt to a port, so there is no payload to choose.</MokaCaption>
						}
					</MokaFlexbox>
				</MokaCard>
			</MokaGrid>
		</div>

		@if (_error is { } error)
		{
			<MokaAlert Severity="MokaToastSeverity.Error" Dense>@error</MokaAlert>
		}

		@if (Running && _stats.Sent == 0 && _mtu is null)
		{
			<RunningCard Text="@(_target ?? "Starting")" />
		}

		@if (_target is not null && (_stats.Sent > 0 || _mtu is not null))
		{
			<PingResultView Target="@_target"
							Stats="_stats"
							Rows="_rows"
							Dropped="_dropped"
							Live="Running"
							Interval="_runInterval"
							Planned="_planned"
							Mtu="_mtu" />
		}
		else if (!Busy && _error is null)
		{
			<MokaEmptyState Icon="NetworkIcons.Ping"
							Title="Ping a host"
							Description="ICMP echo, or TCP connection attempts to one port for a host that drops ICMP. Find path MTU searches for the largest packet the path carries whole."
							Compact />
		}
	</ChildContent>
</NetworkPage>
