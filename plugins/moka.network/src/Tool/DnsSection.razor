@inherits NetworkViewBase

<NetworkPage Title="DNS lookup" Said="@Summary">
	<Actions>
		<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm" StartIcon="NetworkIcons.Race" Disabled="Busy" OnClick="RaceAsync">Race</MokaButton>
		<MokaButton Variant="MokaVariant.Filled"
					Color="MokaColor.Primary"
					Size="MokaSize.Sm"
					StartIcon="@(Running ? NetworkIcons.Stop : NetworkIcons.Dns)"
					Disabled="@(Busy && !Running)"
					OnClick="PrimaryAsync">@(Running ? "Stop" : "Look up")</MokaButton>
	</Actions>
	<Origin>
		<OriginNote />
	</Origin>
	<ChildContent>
		<div @onkeydown="OnKeyAsync">
			<MokaGrid MinColumn="400px" Gap="MokaSpacingScale.Md">
				<MokaCard Inner Outlined Title="Question">
					<MokaFlexbox Gap="MokaSpacingScale.Sm">
						<MokaGrid ColumnsValue="minmax(0, 1fr) 140px" Gap="MokaSpacingScale.Sm">
							<MokaTextField Label="Name or address"
										   Value="@_name"
										   ValueChanged="@(value => _name = value ?? "")"
										   Placeholder="example.com, _sip._tcp.example.com or 192.0.2.10"
										   HelperText="An address is looked up as its PTR record."
										   Size="MokaSize.Sm"
										   spellcheck="false"
										   autocomplete="off"
										   data-autofocus />
							<MokaSelect TValue="DnsRecordType"
										Label="Type"
										Items="DnsNames.Offered"
										Value="_type"
										ValueChanged="@(value => _type = value)"
										ValueSelector="@(type => type.ToString())"
										Size="MokaSize.Sm"
										aria-label="Record type" />
						</MokaGrid>
						<RecentTargetsBar OnPick="@(value => _name = value)" />
					</MokaFlexbox>
				</MokaCard>
				<MokaCard Inner Outlined Title="Resolver">
					<MokaFlexbox Gap="MokaSpacingScale.Sm">
						<EnumSegmentedControl TEnum="DnsResolverKind" Value="_resolver" ValueChanged="@(value => _resolver = value)" Options="Resolvers" AriaLabel="Resolver" Disabled="Busy" />
						@if (_resolver == DnsResolverKind.Custom)
						{
							<MokaTextField Label="Custom resolver"
										   Value="@_custom"
										   ValueChanged="@(value => _custom = value ?? "")"
										   Placeholder="192.168.1.1 or [2001:db8::53]:5353"
										   Size="MokaSize.Sm"
										   spellcheck="false"
										   autocomplete="off" />
						}
						<MokaCaption>Asked over UDP, again over TCP when the answer is cut. @Settings.DnsTimeoutSeconds s per server. Race asks every resolver at once.</MokaCaption>
					</MokaFlexbox>
				</MokaCard>
			</MokaGrid>
		</div>

		@if (_error is { } error)
		{
			<MokaAlert Severity="MokaToastSeverity.Error" Dense>@error</MokaAlert>
		}

		@if (Running)
		{
			<RunningCard Text="@(_racing ? "Asking every resolver at once" : "Asking the resolver")" />
		}

		@if (_race is { } race)
		{
			<ResolverRaceTable Results="race" Question="@_raceQuestion" />
		}

		@if (_result is { } result)
		{
			<DnsAnswerView Result="result" Note="@_note" AskedType="_askedType" />
		}

		@if (!Busy && _result is null && _race is null && _error is null)
		{
			<MokaEmptyState Icon="NetworkIcons.Dns"
							Title="Ask any resolver"
							Description="A name and a record type, or an address for its name. The answer shows every section, the TTLs and the flags exactly as the server sent them."
							Compact />
		}
	</ChildContent>
</NetworkPage>
