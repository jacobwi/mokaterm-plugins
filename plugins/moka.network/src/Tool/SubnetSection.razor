@using Moka.Network.Subnets

<NetworkPage Title="Subnets" Said="@Summary">
	<ChildContent>
		<MokaCard Inner Outlined Title="Prefix">
			<MokaFlexbox Gap="MokaSpacingScale.Sm">
				<MokaTextField Label="Address and prefix"
							   Value="@_input"
							   ValueChanged="OnInputChanged"
							   Placeholder="192.168.1.10/24 or 2001:db8::/48"
							   ErrorText="@ShownProblem"
							   HelperText="A prefix length, or for IPv4 a mask such as /255.255.255.0. An address alone is its own /32 or /128."
							   Size="MokaSize.Sm"
							   spellcheck="false"
							   autocomplete="off" />
			</MokaFlexbox>
		</MokaCard>

		@if (_info is { } info)
		{
			AddressKind kind = AddressKinds.Classify(info.Address);
			<MokaGrid MinColumn="150px" Gap="MokaSpacingScale.Sm" aria-label="Summary">
				<MokaStat Tile Value="@info.Cidr" Label="Prefix" />
				<MokaStat Tile Value="@ShortCount(info.HostCount, info)" Label="Hosts" HelpText="@FullCount(info.HostCount, info)" Color="MokaColor.Success" />
				<MokaStat Tile Value="@ShortCount(info.AddressCount, info)" Label="Addresses" HelpText="@FullCount(info.AddressCount, info)" />
				<MokaStat Tile Value="@kind.Name" Label="Kind" Color="@(kind.IsPublic ? MokaColor.Info : null)" />
			</MokaGrid>

			@if (kind.Note is { } note)
			{
				<MokaCallout Type="MokaCalloutType.Note" Title="@(kind.RangePrefix > 0 ? $"{kind.Name}, {kind.Range}" : kind.Name)">@note</MokaCallout>
			}
			@if (kind.RangePrefix > info.PrefixLength)
			{
				<MokaAlert Severity="MokaToastSeverity.Warning" Dense>This prefix is wider than that range, so part of it lies outside.</MokaAlert>
			}

			<MokaGrid MinColumn="300px" Gap="MokaSpacingScale.Md" AlignItems="MokaAlign.Start">
				<MokaCard Inner Outlined Title="Range">
					<MokaFlexbox Gap="MokaSpacingScale.Sm">
						<MokaDataList Items="@RangeFacts(info)" Dense Orientation="MokaDirection.Row" />
					</MokaFlexbox>
				</MokaCard>
				<MokaCard Inner Outlined Title="Mask">
					<MokaFlexbox Gap="MokaSpacingScale.Sm">
						<MokaDataList Items="@MaskFacts(info)" Dense Orientation="MokaDirection.Row" />
					</MokaFlexbox>
				</MokaCard>
			</MokaGrid>

			<MokaGrid MinColumn="300px" Gap="MokaSpacingScale.Md" AlignItems="MokaAlign.Start">
				<MokaCard Inner Outlined Title="Does an address fall inside">
					<MokaFlexbox Gap="MokaSpacingScale.Sm">
						<MokaTextField Label="Address"
									   Value="@_inside"
									   ValueChanged="@(value => _inside = value ?? "")"
									   Placeholder="@(info.IsIPv6 ? "2001:db8::42" : "192.168.1.200")"
									   Size="MokaSize.Sm"
									   spellcheck="false"
									   autocomplete="off"
									   aria-label="Address to test" />
						@if (InsideResult(info) is { } inside)
						{
							<MokaAlert Severity="@(inside.Inside ? MokaToastSeverity.Success : inside.Problem ? MokaToastSeverity.Info : MokaToastSeverity.Error)" Dense>@inside.Text</MokaAlert>
						}
					</MokaFlexbox>
				</MokaCard>
				<MokaCard Inner Outlined Title="Split into smaller subnets">
					<MokaFlexbox Gap="MokaSpacingScale.Sm">
						<MokaTextField Label="How many, or their prefix"
									   Value="@_split"
									   ValueChanged="@(value => _split = value ?? "")"
									   Placeholder="4, or a prefix such as /26"
									   Size="MokaSize.Sm"
									   spellcheck="false"
									   autocomplete="off"
									   aria-label="How many subnets, or their prefix length" />
						@if (_split.Trim().Length > 0 && !SubnetMath.TryParseSplit(_split, info, out _, out string? splitProblem))
						{
							<MokaAlert Severity="MokaToastSeverity.Info" Dense>@splitProblem</MokaAlert>
						}
					</MokaFlexbox>
				</MokaCard>
			</MokaGrid>

			@if (_split.Trim().Length > 0 && SubnetMath.TryParseSplit(_split, info, out int prefix, out _))
			{
				IReadOnlyList<SubnetInfo> parts = SubnetMath.Split(info, prefix, SubnetMath.MaxSplitRows, out System.Numerics.BigInteger total);
				<MokaCard Inner Outlined Title="Subnets" Subtitle="@SplitSummary(info, prefix, total, parts.Count)">
					<MokaFlexbox Gap="MokaSpacingScale.Sm">
						<MokaTable TItem="IndexedRow<SubnetInfo>"
								   Items="@IndexedRows.Of(parts)"
								   ItemKey="@(row => row.Index)"
								   Label="Subnets"
								   ShowToolbar="false"
								   ShowPagination="@(parts.Count > SplitPage)"
								   PageSize="SplitPage"
								   Bleed>
							<MokaColumn TItem="IndexedRow<SubnetInfo>" Title="#" Field="@(row => row.Index + 1)" Mono Width="56px" />
							<MokaColumn TItem="IndexedRow<SubnetInfo>" Title="Subnet" Field="@(row => row.Item.Cidr)" Mono Sortable="false" />
							<MokaColumn TItem="IndexedRow<SubnetInfo>" Title="Hosts" Field="@(row => $"{row.Item.FirstHost} - {row.Item.LastHost}")" Mono Sortable="false" />
							<MokaColumn TItem="IndexedRow<SubnetInfo>" Title="Count" Field="@(row => row.Item.HostCount)" Mono Align="MokaTextAlign.Right">
								<CellTemplate Context="row">@CountText(row.Item.HostCount, row.Item)</CellTemplate>
							</MokaColumn>
						</MokaTable>
					</MokaFlexbox>
				</MokaCard>
			}
		}
	</ChildContent>
</NetworkPage>

@code {
	private static IReadOnlyList<MokaDataListItem> RangeFacts(SubnetInfo info) =>
	[
		new("PREFIX", ValueContent: Copyable(info.Cidr, "Copy the prefix")),
		new("NETWORK", ValueContent: Copyable(info.Network.ToString(), "Copy the network address")),
		info.Broadcast is { } broadcast
			? new("BROADCAST", ValueContent: Mono(broadcast.ToString()))
			: new("BROADCAST", info.IsIPv6 ? "None: IPv6 has no broadcast address." : "None: every address is a host's."),
		new("FIRST HOST", ValueContent: Mono(info.FirstHost.ToString())),
		new("LAST HOST", ValueContent: Mono(info.LastHost.ToString())),
	];

	private static IReadOnlyList<MokaDataListItem> MaskFacts(SubnetInfo info)
	{
		List<MokaDataListItem> facts = [new("MASK", ValueContent: Mono(info.Mask.ToString()))];
		if (!info.IsIPv6)
		{
			facts.Add(new("BINARY", ValueContent: Mono(SubnetMath.Binary(info.Mask))));
		}

		if (info.Wildcard is { } wildcard)
		{
			facts.Add(new("WILDCARD", ValueContent: Mono(wildcard.ToString())));
		}

		if (info.IsIPv6)
		{
			facts.Add(new("WRITTEN OUT", ValueContent: Mono(SubnetMath.Expanded(info.Network))));
		}

		return facts;
	}

	/// <summary>An address or a mask in mono, free to wrap after each dot or colon, so a long one stays inside its card.</summary>
	private static RenderFragment Mono(string text) =>
		@<MokaText Element="span" Mono>
			@foreach (string part in Parts(text))
			{
				@part<wbr />
			}
		</MokaText>;

	/// <summary>The text cut after each dot and colon, every piece keeping its separator.</summary>
	private static IEnumerable<string> Parts(string text)
	{
		int start = 0;
		for (int index = 0; index < text.Length; index++)
		{
			if (text[index] is '.' or ':')
			{
				yield return text[start..(index + 1)];
				start = index + 1;
			}
		}

		if (start < text.Length)
		{
			yield return text[start..];
		}
	}

	private static RenderFragment Copyable(string text, string label) =>
		@<MokaFlexbox Direction="MokaDirection.Row" Align="MokaAlign.Center" GapValue="4px">
			@Mono(text)
			<CopyButton Text="@text" Label="@label" />
		</MokaFlexbox>;
}
