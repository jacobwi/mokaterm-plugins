@inherits NetworkViewBase
@using Moka.Network.Whois

<NetworkPage Title="Whois" Said="@Summary">
	<Actions>
		@if (_answers.Any(answer => answer.Error is null))
		{
			<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm" StartIcon="MokaIcons.Content.Copy" OnClick="CopyAllAsync">Copy all</MokaButton>
		}
		<MokaButton Variant="MokaVariant.Filled"
					Color="MokaColor.Primary"
					Size="MokaSize.Sm"
					StartIcon="@(Running ? NetworkIcons.Stop : NetworkIcons.Whois)"
					Disabled="@(Busy && !Running)"
					OnClick="PrimaryAsync">@(Running ? "Stop" : "Look up")</MokaButton>
	</Actions>
	<Origin>
		<OriginNote />
	</Origin>
	<ChildContent>
		<MokaCard Inner Outlined Title="Query">
			<MokaFlexbox Gap="MokaSpacingScale.Sm">
				<div @onkeydown="OnKeyAsync">
					<MokaTextField Label="Domain or address"
								   Value="@_query"
								   ValueChanged="@(value => _query = value ?? "")"
								   Placeholder="example.com or 192.0.2.10"
								   Size="MokaSize.Sm"
								   spellcheck="false"
								   autocomplete="off" />
				</div>
				<RecentTargetsBar OnPick="@(value => _query = value)" />
				<MokaCaption>Asks @WhoisClient.RootServer on TCP port 43, then follows up to @WhoisClient.MaxReferrals referrals. @Settings.WhoisTimeoutSeconds s per server, @(WhoisClient.MaxTotalBytes / 1024) KiB in all. A domain that port 43 gives nothing for is asked of its registry over RDAP, which is HTTPS.</MokaCaption>
			</MokaFlexbox>
		</MokaCard>

		@if (_error is { } error)
		{
			<MokaAlert Severity="MokaToastSeverity.Error" Dense>@error</MokaAlert>
		}

		@if (Running)
		{
			<RunningCard Text="@RunningText" />
		}

		@if (_answers.Count > 0 || _rdap is not null)
		{
			<WhoisResultView Answers="_answers" Rdap="_rdap" Note="@_note" />
		}
		else if (!Busy && _error is null)
		{
			<MokaEmptyState Icon="NetworkIcons.Whois"
							Title="Who holds a domain or an address"
							Description="Starts at IANA and follows the registries' referrals, each answer shown as the server sent it."
							Compact />
		}
	</ChildContent>
</NetworkPage>
