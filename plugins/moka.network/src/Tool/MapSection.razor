@inherits NetworkViewBase
@using Moka.Network.Lookup.Mapping

<NetworkPage Title="Map" Said="@Summary">
	<Actions>
		<MokaButton Variant="MokaVariant.Filled"
					Color="MokaColor.Primary"
					Size="MokaSize.Sm"
					StartIcon="@(Running ? NetworkIcons.Stop : NetworkIcons.Map)"
					Disabled="@(Busy && !Running)"
					OnClick="PrimaryAsync">@(Running ? "Stop" : "Draw the map")</MokaButton>
	</Actions>
	<Origin>
		<OriginNote />
	</Origin>
	<ChildContent>
		<MokaGrid MinColumn="400px" Gap="MokaSpacingScale.Md">
			<MokaCard Inner Outlined Title="Name">
				<MokaFlexbox Gap="MokaSpacingScale.Sm">
					<div @onkeydown="OnKeyAsync">
						<MokaGrid ColumnsValue="minmax(0, 1fr) 120px" Gap="MokaSpacingScale.Sm">
							<MokaTextField Label="Name"
										   Value="@_name"
										   ValueChanged="@(value => _name = value ?? "")"
										   Placeholder="example.com"
										   HelperText="@($"The delegation is asked of the root servers directly, without recursion. {Settings.DnsTimeoutSeconds} s per server.")"
										   Size="MokaSize.Sm"
										   spellcheck="false"
										   autocomplete="off"
										   data-autofocus />
							<MokaSelect TValue="DnsRecordType"
										Label="Type"
										Items="@MapTypes"
										Value="_type"
										ValueChanged="@(value => _type = value)"
										ValueSelector="@(type => type.ToString())"
										Size="MokaSize.Sm"
										aria-label="Record type" />
						</MokaGrid>
					</div>
					<RecentTargetsBar OnPick="@(value => _name = value)" />
				</MokaFlexbox>
			</MokaCard>
			<MokaCard Inner Outlined Title="PTR sweep">
				<MokaFlexbox Gap="MokaSpacingScale.Sm">
					<MokaGrid ColumnsValue="minmax(0, 1fr) auto" Gap="MokaSpacingScale.Sm" AlignItems="MokaAlign.End">
						<MokaTextField Label="PTR sweep of"
									   Value="@_prefix"
									   ValueChanged="@(value => _prefix = value ?? "")"
									   Placeholder="192.168.1.0/24"
									   Size="MokaSize.Sm"
									   spellcheck="false"
									   autocomplete="off"
									   aria-label="Prefix to sweep for PTR records" />
						<MokaButton Variant="MokaVariant.Outlined"
									Size="MokaSize.Sm"
									StartIcon="NetworkIcons.Dns"
									Disabled="Busy"
									OnClick="SweepAsync">Sweep PTRs</MokaButton>
					</MokaGrid>
					<MokaCaption>Every address asked for its name, up to a /24.</MokaCaption>
				</MokaFlexbox>
			</MokaCard>
		</MokaGrid>

		@if (_error is { } error)
		{
			<MokaAlert Severity="MokaToastSeverity.Error" Dense>@error</MokaAlert>
		}

		@if (Running && _sweepTotal > 0)
		{
			<RunningCard Text="@($"Asking {Count(_sweepDone)} of {Count(_sweepTotal)} addresses for their names")" Progress="@(100.0 * _sweepDone / _sweepTotal)" />
		}
		else if (Running && _stage is { } stage)
		{
			<RunningCard Text="@(char.ToUpperInvariant(stage[0]) + stage[1..])" />
		}

		@if (_views is { Any: true } views)
		{
			<MapResultView Views="views" Note="@_note" />
		}
		else if (!Busy && _error is null)
		{
			<MokaEmptyState Icon="NetworkIcons.Map"
							Title="See how a name resolves"
							Description="The delegation from the roots down, the CNAMEs hop by hop and every resolver's answer side by side. Or sweep a prefix for the names its addresses carry."
							Compact />
		}
	</ChildContent>
</NetworkPage>
