@inherits AppToolBase

@* The Network Toolkit: a side menu of tabs, each kept alive while another shows, so switching back finds what was
   typed and what a run found, and a ping left running keeps going. Closing the tool disposes every tab, which stops
   whatever still runs. *@
<NetworkToolShell Entries="Entries" Current="@_current" CurrentChanged="Show" Label="Network Toolkit">
	<NetworkTab Shown="@(_current == DnsId)">
		<DnsSection />
	</NetworkTab>
	<NetworkTab Shown="@(_current == MapId)">
		<MapSection />
	</NetworkTab>
	<NetworkTab Shown="@(_current == PingId)">
		<PingSection />
	</NetworkTab>
	<NetworkTab Shown="@(_current == PortId)">
		<PortSection />
	</NetworkTab>
	<NetworkTab Shown="@(_current == TraceId)">
		<TraceSection />
	</NetworkTab>
	<NetworkTab Shown="@(_current == WhoisId)">
		<WhoisSection />
	</NetworkTab>
	<NetworkTab Shown="@(_current == WakeId)">
		<WakeSection />
	</NetworkTab>
	<NetworkTab Shown="@(_current == SubnetId)">
		<SubnetSection />
	</NetworkTab>
	<NetworkTab Shown="@(_current == ConnectionsId)">
		<DesktopConnectionsPanel />
	</NetworkTab>
</NetworkToolShell>
