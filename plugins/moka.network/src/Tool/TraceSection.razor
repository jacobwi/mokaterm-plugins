@inherits NetworkViewBase
@using Moka.Network.Echo

<NetworkPage Title="Traceroute" Said="@Summary">
	<Actions>
		<MokaButton Variant="MokaVariant.Filled"
					Color="MokaColor.Primary"
					Size="MokaSize.Sm"
					StartIcon="@(Running ? NetworkIcons.Stop : NetworkIcons.Trace)"
					Disabled="@(Busy && !Running)"
					OnClick="PrimaryAsync">@(Running ? "Stop" : "Trace")</MokaButton>
	</Actions>
	<Origin>
		<OriginNote />
	</Origin>
	<ChildContent>
		<div @onkeydown="OnKeyAsync">
			<MokaGrid MinColumn="400px" Gap="MokaSpacingScale.Md">
				<MokaCard Inner Outlined Title="Target">
					<MokaFlexbox Gap="MokaSpacingScale.Sm">
						<MokaTextField Label="Host" Value="@_host" ValueChanged="@(value => _host = value ?? "")" Placeholder="example.com or 192.0.2.10" Size="MokaSize.Sm" spellcheck="false" autocomplete="off" />
						<MokaFieldWrapper Label="Address family" CustomControl Size="MokaSize.Sm">
							<EnumSegmentedControl TEnum="AddressChoice" Value="_choice" ValueChanged="@(value => _choice = value)" Options="AddressChoices.Options" AriaLabel="Address family" Disabled="Busy" />
						</MokaFieldWrapper>
						<RecentTargetsBar OnPick="@(value => _host = value)" />
					</MokaFlexbox>
				</MokaCard>
				<MokaCard Inner Outlined Title="Probes">
					<MokaFlexbox Gap="MokaSpacingScale.Sm">
						<MokaGrid MinColumn="120px" Gap="MokaSpacingScale.Sm">
							<MokaTextField Label="Max hops" Value="@_maxHops" ValueChanged="@(value => _maxHops = value ?? "")" Placeholder="30" Size="MokaSize.Sm" inputmode="numeric" autocomplete="off" />
							<MokaTextField Label="Wait (ms)" Value="@_timeout" ValueChanged="@(value => _timeout = value ?? "")" Size="MokaSize.Sm" inputmode="numeric" autocomplete="off" />
						</MokaGrid>
						<MokaCheckbox Label="Look up hop names" Value="_lookupNames" ValueChanged="@(value => _lookupNames = value)" />
						<MokaCaption>ICMP echo with a rising TTL, @TraceOptions.DefaultProbesPerHop probes per hop. Hop names come from the DNS tab's default resolver (@DnsResolvers.Label(Settings.Resolver)).</MokaCaption>
					</MokaFlexbox>
				</MokaCard>
			</MokaGrid>
		</div>

		@if (_error is { } error)
		{
			<MokaAlert Severity="MokaToastSeverity.Error" Dense>@error</MokaAlert>
		}

		@if (Running)
		{
			<RunningCard Text="@(_hops.Count == 0 ? _target ?? "Starting" : $"Hop {_hops.Count}")" />
		}

		@if (_target is not null && (_hops.Count > 0 || _end is not null))
		{
			<TraceResultView Target="@_target" Hops="_hops" Names="_names" End="_end" Stopped="_stopped" Destination="_destination" />
		}
		else if (!Busy && _error is null)
		{
			<MokaEmptyState Icon="NetworkIcons.Trace"
							Title="Trace the path to a host"
							Description="Every router on the way, hop by hop, with each probe's round trip and the hops' names looked up beside the trace."
							Compact />
		}
	</ChildContent>
</NetworkPage>
