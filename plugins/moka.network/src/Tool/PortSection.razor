@inherits NetworkViewBase
@using Moka.Network.Ports

<NetworkPage Title="Port check" Said="@Summary">
	<Actions>
		<MokaButton Variant="MokaVariant.Filled"
					Color="MokaColor.Primary"
					Size="MokaSize.Sm"
					StartIcon="@(Running ? NetworkIcons.Stop : NetworkIcons.Port)"
					Disabled="@(Busy && !Running)"
					OnClick="PrimaryAsync">@(Running ? "Stop" : "Check")</MokaButton>
	</Actions>
	<Origin>
		<OriginNote />
	</Origin>
	<ChildContent>
		<div @onkeydown="OnKeyAsync">
			<MokaGrid MinColumn="400px" Gap="MokaSpacingScale.Md">
				<MokaCard Inner Outlined Title="Target">
					<MokaFlexbox Gap="MokaSpacingScale.Sm">
						<MokaTextField Label="Host" Value="@_host" ValueChanged="@(value => _host = value ?? "")" Placeholder="example.com or 192.0.2.10" Size="MokaSize.Sm" spellcheck="false" autocomplete="off" />
						<MokaFieldWrapper Label="Address family" CustomControl Size="MokaSize.Sm">
							<EnumSegmentedControl TEnum="AddressChoice" Value="_choice" ValueChanged="@(value => _choice = value)" Options="AddressChoices.Options" AriaLabel="Address family" Disabled="Busy" />
						</MokaFieldWrapper>
						<RecentTargetsBar OnPick="@(value => _host = value)" />
					</MokaFlexbox>
				</MokaCard>
				<MokaCard Inner Outlined Title="Ports">
					<MokaFlexbox Gap="MokaSpacingScale.Sm">
						<MokaGrid MinColumn="150px" Gap="MokaSpacingScale.Sm">
							<MokaTextField Label="Ports" Value="@_ports" ValueChanged="@(value => _ports = value ?? "")" Placeholder="22, 443, rdp" HelperText="@($"Up to {PortList.MaxPorts}, by number or name")" Size="MokaSize.Sm" spellcheck="false" autocomplete="off" />
							<MokaTextField Label="Custom ports" Value="@_custom" ValueChanged="@(value => _custom = value ?? "")" Placeholder="9, 3000 8080" HelperText="@($"Up to {PortList.MaxCustomPorts} more numbers")" Size="MokaSize.Sm" inputmode="numeric" autocomplete="off" />
						</MokaGrid>
						<MokaCheckbox Label="Read what the server says first" Value="_greeting" ValueChanged="@(value => _greeting = value)" />
						<MokaCaption>No ranges. Each port gets one TCP connection, closed at once; nothing is sent. @Settings.ConnectTimeoutSeconds s per port.</MokaCaption>
					</MokaFlexbox>
				</MokaCard>
			</MokaGrid>
		</div>

		@if (_error is { } error)
		{
			<MokaAlert Severity="MokaToastSeverity.Error" Dense>@error</MokaAlert>
		}

		@if (Running && _rows.Count > 0 && _rows.All(row => row.Result is null))
		{
			<RunningCard Text="@(_target ?? "Connecting")" />
		}

		@if (_target is not null && _rows.Count > 0)
		{
			<PortResultView Target="@_target" Rows="_rows" CustomOnly="_customOnly" GreetingAsked="_greetingAsked" />
		}
		else if (!Busy && _error is null)
		{
			<MokaEmptyState Icon="NetworkIcons.Port"
							Title="Does a port accept a connection"
							Description="A few known ports by number or name, all at once, each with its own time limit. A check, not a scan."
							Compact />
		}
	</ChildContent>
</NetworkPage>
