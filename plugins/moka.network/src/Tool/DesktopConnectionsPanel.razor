@* This machine's own TCP connections and the ports it listens on, read again every few seconds while the
   Connections tab is on screen. Rows are keyed by their place in the read: a connection table can hold two rows with
   the same local end, remote end and state, and a repeated key throws when the next read diffs. *@
<NetworkPage Title="Connections" Said="@Said">
	<Origin>
		<OriginNote />
	</Origin>
	<ChildContent>
		<MokaGrid MinColumn="320px" Gap="MokaSpacingScale.Md">
			<MokaGrid Columns="2" Gap="MokaSpacingScale.Sm" aria-label="Summary">
				<MokaStat Tile Value="@NetworkFormat.Count(_connections.Count)" Label="Connections" />
				<MokaStat Tile Value="@NetworkFormat.Count(_connections.Count(row => row.State == Established))" Label="Established" Color="MokaColor.Success" />
				<MokaStat Tile Value="@NetworkFormat.Count(_listeners.Count(row => row.Protocol == "tcp"))" Label="Listening on TCP" />
				<MokaStat Tile Value="@NetworkFormat.Count(_listeners.Count(row => row.Protocol == "udp"))" Label="Listening on UDP" />
			</MokaGrid>
			<MokaCard Inner Outlined Title="States" Subtitle="The TCP connections by state">
				<MokaFlexbox Gap="MokaSpacingScale.Sm">
					@if (_connections.Count > 0)
					{
						<MokaDonutChart Segments="@StateShare" Thickness="14" Size="MokaSize.Sm" Label="TCP connections by state" />
					}
					else
					{
						<MokaCaption>This computer holds no TCP connections right now.</MokaCaption>
					}
				</MokaFlexbox>
			</MokaCard>
		</MokaGrid>

		<MokaCard Inner Outlined Title="TCP connections" Subtitle="The .NET APIs it reads do not say which process owns a connection, so the table cannot either.">
			<MokaFlexbox Gap="MokaSpacingScale.Sm">
				<MokaTable TItem="IndexedRow<LocalConnectionRow>"
						   Items="@IndexedRows.Of(_connections)"
						   ItemKey="@(row => row.Index)"
						   Label="TCP connections"
						   ShowToolbar="false"
						   ShowPagination="@(_connections.Count > ConnectionsPage)"
						   PageSize="ConnectionsPage"
						   EmptyTitle="No connections"
						   EmptyText="This computer holds no TCP connections right now."
						   Bleed>
					<MokaColumn TItem="IndexedRow<LocalConnectionRow>" Title="Local" Field="@(row => row.Item.Local)" Mono />
					<MokaColumn TItem="IndexedRow<LocalConnectionRow>" Title="Remote" Field="@(row => row.Item.Remote)" Mono />
					<MokaColumn TItem="IndexedRow<LocalConnectionRow>" Title="State" Field="@(row => row.Item.State)">
						<CellTemplate Context="row">
							<MokaTag Text="@row.Item.State" Color="@StateColor(row.Item.State)" />
						</CellTemplate>
					</MokaColumn>
				</MokaTable>
			</MokaFlexbox>
		</MokaCard>

		<MokaCard Inner Outlined Title="Listening" Subtitle="@NetworkFormat.Plural(_listeners.Count, "port")">
			<MokaFlexbox Gap="MokaSpacingScale.Sm">
				<MokaTable TItem="IndexedRow<LocalListenerRow>"
						   Items="@IndexedRows.Of(_listeners)"
						   ItemKey="@(row => row.Index)"
						   Label="Listening ports"
						   ShowToolbar="false"
						   ShowPagination="@(_listeners.Count > ListeningPage)"
						   PageSize="ListeningPage"
						   EmptyTitle="Nothing is listening"
						   Bleed>
					<MokaColumn TItem="IndexedRow<LocalListenerRow>" Title="Protocol" Field="@(row => row.Item.Protocol)" Width="120px">
						<CellTemplate Context="row">
							<MokaTag Text="@row.Item.Protocol" Color="@(row.Item.Protocol == "tcp" ? MokaColor.Info : MokaColor.Secondary)" />
						</CellTemplate>
					</MokaColumn>
					<MokaColumn TItem="IndexedRow<LocalListenerRow>" Title="Listening on" Field="@(row => row.Item.Local)" Mono />
				</MokaTable>
			</MokaFlexbox>
		</MokaCard>
	</ChildContent>
</NetworkPage>
