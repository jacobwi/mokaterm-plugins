@* This machine's own TCP connections and the ports it listens on, read again every few seconds while the
   Connections tab is on screen. *@
<div class="mn-conn">
	<div class="mn-conn-head">
		<span class="mn-label">This machine's connections</span>
		<span class="mn-note">@Read</span>
	</div>
	<div class="mn-note">Read from this computer's own connection table. The .NET APIs it reads do not say which process owns a connection, so the table cannot either.</div>

	@if (_connections.Count > 0)
	{
		@* The heading sits outside the scrolled part: a sticky header over rows whose text changes every read left
		   WebView2 showing a smear until something forced a repaint. The rows are deliberately NOT keyed: a connection
		   table can hold two rows with the same local end, remote end and state, and a repeated key throws when the
		   next read diffs, which took the whole tool down. *@
		<div class="mn-conn-table" role="table" aria-label="TCP connections">
			<div class="mn-conn-row mn-conn-row--head" role="row">
				<span role="columnheader">Local</span>
				<span role="columnheader">Remote</span>
				<span role="columnheader">State</span>
			</div>
			<div class="mn-conn-rows" role="rowgroup">
				@foreach (LocalConnectionRow row in _connections)
				{
					<div class="mn-conn-row" role="row">
						<span class="mn-conn-cell mn-conn-cell--mono" role="cell">@row.Local</span>
						<span class="mn-conn-cell mn-conn-cell--mono" role="cell">@row.Remote</span>
						<span class="mn-conn-cell" role="cell">@row.State</span>
					</div>
				}
			</div>
		</div>
	}
	else
	{
		<p class="mn-note">This computer holds no TCP connections right now.</p>
	}

	@if (_listeners.Count > 0)
	{
		<div class="mn-conn-table mn-conn-table--listening" role="table" aria-label="Listening ports">
			<div class="mn-conn-row mn-conn-row--head" role="row">
				<span role="columnheader">Protocol</span>
				<span role="columnheader">Listening on</span>
			</div>
			<div class="mn-conn-rows" role="rowgroup">
				@foreach (LocalListenerRow row in _listeners)
				{
					<div class="mn-conn-row" role="row">
						<span class="mn-conn-cell mn-conn-cell--mono" role="cell">@row.Protocol</span>
						<span class="mn-conn-cell mn-conn-cell--mono" role="cell">@row.Local</span>
					</div>
				}
			</div>
		</div>
	}
</div>
