@* The hosts this app run has already asked about, one click from the field above. In memory only, shared by every
   tab of the tool, and never written anywhere. *@
@if (_shown.Count > 0)
{
	<div class="mn-recent" role="group" aria-label="Recent targets">
		<span class="mn-label">Recent</span>
		@foreach (string target in _shown)
		{
			<button type="button" class="mn-recent-chip" title="@($"Put {target} in the field")" @onclick="() => OnPick.InvokeAsync(target)">@target</button>
		}
	</div>
}

@code {
	/// <summary>How many chips show at most; the service keeps more than the bar has room for.</summary>
	public const int Shown = 6;

	[Inject]
	private RecentTargets Targets { get; set; } = default!;

	/// <summary>Called with the chip's target; the section puts it in its own field.</summary>
	[Parameter]
	public EventCallback<string> OnPick { get; set; }

	private IReadOnlyList<string> _shown = [];

	protected override void OnParametersSet() => _shown = Targets.Recent(Shown);
}
