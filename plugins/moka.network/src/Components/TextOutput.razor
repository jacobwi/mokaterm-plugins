@* Text a server sent or a result put together, in a card: a title, a detail, a copy button that goes through
   Mokaterm's clipboard, and the text in Moka's code block, which scrolls on its own. The text is already plain. *@
<MokaCard Inner Outlined Title="@Title" Subtitle="@Detail">
	<HeaderActions>
		@Actions
		@if (Text.Length > 0)
		{
			<CopyButton Text="@Text" Label="@(CopyLabel ?? $"Copy {Title}")" />
		}
	</HeaderActions>
	<ChildContent>
		<MokaFlexbox Gap="MokaSpacingScale.Sm">
			@if (Text.Length > 0)
			{
				<MokaCodeBlock Code="@Text"
							   Language="@Language"
							   ShowCopyButton="false"
							   ShowLineNumbers="false"
							   Wrap
							   MaxHeight="@(Tall ? "420px" : "240px")" />
			}
			@ChildContent
		</MokaFlexbox>
	</ChildContent>
</MokaCard>

@code {
	[Parameter, EditorRequired]
	public string Title { get; set; } = "";

	[Parameter]
	public string? Detail { get; set; }

	[Parameter]
	public string Text { get; set; } = "";

	/// <summary>What the copy button says it copies; "Copy" and the title when not set.</summary>
	[Parameter]
	public string? CopyLabel { get; set; }

	/// <summary>The code block's language, such as json, for its colours. Plain text when not set.</summary>
	[Parameter]
	public string? Language { get; set; }

	/// <summary>A long answer, such as whois, gets a taller box.</summary>
	[Parameter]
	public bool Tall { get; set; }

	[Parameter]
	public RenderFragment? Actions { get; set; }

	[Parameter]
	public RenderFragment? ChildContent { get; set; }
}
