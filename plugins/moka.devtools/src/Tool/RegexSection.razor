@inherits DevToolViewBase

<SectionFrame Title="Regex" Said="@Summary">
	<MokaCard Inner Outlined Title="Pattern">
		<MokaFlexbox Gap="MokaSpacingScale.Md">
			<MokaFlexbox Gap="MokaSpacingScale.Xs">
				<MokaLabel Micro>Common patterns</MokaLabel>
				<MokaFlexbox Direction="MokaDirection.Row" Align="MokaAlign.Center" Gap="MokaSpacingScale.Xs" Wrap>
					@foreach (RegexPreset preset in RegexPresets.All)
					{
						<Hint Text="@($"{preset.Description} {preset.Pattern}")">
							<MokaChip Text="@preset.Name" Size="MokaSize.Sm" OnClick="() => UsePresetAsync(preset)" />
						</Hint>
					}
				</MokaFlexbox>
			</MokaFlexbox>
			<MokaGrid ColumnsValue="minmax(0, 1fr) auto" Gap="MokaSpacingScale.Md" AlignItems="MokaAlign.End">
				<MokaTextField Mono
							   Label="Pattern"
							   Value="@_pattern"
							   ValueChanged="OnPatternChangedAsync"
							   Placeholder="Without the slashes: ERROR (?<code>\d+)"
							   Suffix="@($"/{FlagText}")"
							   Size="MokaSize.Sm"
							   spellcheck="false"
							   autocomplete="off"
							   aria-label="Pattern" />
				<MokaFlexbox Gap="MokaSpacingScale.Xxs">
					<MokaLabel Micro>Flags</MokaLabel>
					<MokaFlexbox Direction="MokaDirection.Row" Align="MokaAlign.Center" Gap="MokaSpacingScale.Xxs">
						@foreach ((char flag, string meaning) in Flags)
						{
							bool on = _flags.Contains(flag);
							<Hint Text="@meaning">
								<MokaChip Text="@flag.ToString()"
										  Size="MokaSize.Sm"
										  Selected="on"
										  SelectedChanged="@(value => OnFlagChangedAsync(flag, value))"
										  aria-pressed="@(on ? "true" : "false")"
										  aria-label="@meaning" />
							</Hint>
						}
					</MokaFlexbox>
				</MokaFlexbox>
			</MokaGrid>
			<MokaCaption>JavaScript's own engine, the one terminal triggers use. Each run gets @RegexRequest.DefaultTimeoutMs ms in a worker the page stops, so a pattern that backtracks without end cannot freeze the window. The common patterns are pragmatic rather than true to any RFC; picking one puts it in the box.</MokaCaption>
		</MokaFlexbox>
	</MokaCard>

	<TextInput Label="Sample text" Value="_sample" ValueChanged="OnSampleChangedAsync" Placeholder="The text to search" Rows="6" AllowFile FileWhat="a text file" />

	@if (_result is { } result)
	{
		<RegexResultView Result="result" Text="@_ranText" IgnoredFlags="@FlagsTriggersIgnore" />
	}
	else if (_running)
	{
		<MokaCard Inner Outlined>
			<MokaProgress />
		</MokaCard>
	}
	else
	{
		<MokaEmptyState Compact
						Icon="DevToolIcons.Regex"
						Title="Nothing to match yet"
						Description="@(_pattern.Length == 0 ? "Type a pattern, or pick a common one." : "Type or open some sample text.")" />
	}
</SectionFrame>
