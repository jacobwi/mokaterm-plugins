@inherits DevToolViewBase

<SectionFrame Title="Hashes" Said="@Summary">
	<MokaCard Inner Outlined Title="Input">
		<MokaFlexbox Gap="MokaSpacingScale.Sm">
			<MokaFlexbox Direction="MokaDirection.Row" Align="MokaAlign.Center" Gap="MokaSpacingScale.Md" Wrap>
				<EnumSegmentedControl TEnum="HashSource" Value="_source" ValueChanged="OnSourceChangedAsync" Options="Sources" AriaLabel="What to hash" Disabled="_hashing" />
				<MokaSwitch Label="HMAC with a key" Value="_hmac" ValueChanged="OnHmacChangedAsync" Disabled="_hashing" />
			</MokaFlexbox>
			@if (_hmac)
			{
				<MokaGrid ColumnsValue="minmax(0, 1fr) auto" Gap="MokaSpacingScale.Sm" AlignItems="MokaAlign.End">
					<SecretField Label="HMAC key" Value="@_key" ValueChanged="OnKeyChangedAsync" Placeholder="The key, cleared after each use" Disabled="_hashing" />
					<EnumSegmentedControl TEnum="KeyFormat" Value="_keyFormat" ValueChanged="OnKeyFormatChangedAsync" Options="KeyFormats" AriaLabel="Key format" Disabled="_hashing" />
				</MokaGrid>
			}
		</MokaFlexbox>
	</MokaCard>

	@if (_source == HashSource.Text)
	{
		<TextInput Label="Text" Value="_text" ValueChanged="OnTextChangedAsync" Placeholder="Type or paste text. It is hashed as UTF-8, exactly as it is here." Rows="4" Mono="false" />
	}
	else
	{
		<MokaCard Inner Outlined Title="File" Subtitle="@(_fileSize is { } size ? Size(size) : null)">
			<HeaderActions>
				@if (_hashing)
				{
					<MokaButton Variant="MokaVariant.Text" Color="MokaColor.Surface" Size="MokaSize.Xs" StartIcon="MokaIcons.Navigation.Close" OnClick="CancelFile">Cancel</MokaButton>
				}
				else
				{
					<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Xs" StartIcon="MokatermIcons.FolderOpen" OnClick="PickFileAsync">Choose a file</MokaButton>
				}
			</HeaderActions>
			<ChildContent>
				<MokaFlexbox Gap="MokaSpacingScale.Sm">
					@if (_fileName is { } name)
					{
						<MokaFlexbox Direction="MokaDirection.Row" Align="MokaAlign.Center" Gap="MokaSpacingScale.Sm" Wrap>
							<MokaTag Text="@name" Icon="MokaIcons.File.Document" />
						</MokaFlexbox>
					}
					@if (_hashing)
					{
						<MokaProgress Value="@Percent" />
						<MokaCaption>@ProgressText</MokaCaption>
					}
					<MokaCaption>@FileNote</MokaCaption>
				</MokaFlexbox>
			</ChildContent>
		</MokaCard>
	}

	@if (_error is { } error)
	{
		<MokaAlert Severity="MokaToastSeverity.Error" Dense>@error</MokaAlert>
	}

	<MokaCard Inner Outlined Title="Compare">
		<MokaFlexbox Gap="MokaSpacingScale.Sm">
			<MokaTextField Mono
						   Label="Expected hash"
						   Value="@_expected"
						   ValueChanged="OnExpectedChanged"
						   Placeholder="Hex in any case, Base64, sha256sum output or sha384-..."
						   Size="MokaSize.Sm"
						   spellcheck="false"
						   autocomplete="off"
						   aria-label="Expected hash" />
			@if (Comparison is { } comparison)
			{
				<ResultLine Title="@comparison.Title" Tone="@comparison.Tone">@comparison.Text</ResultLine>
			}
		</MokaFlexbox>
	</MokaCard>

	@if (_values is { } values)
	{
		<HashTable Values="values" Hmac="_valuesAreHmac" Format="_format" FormatChanged="@(value => _format = value)" Expected="ExpectedBytes" />
	}
	else if (!_hashing)
	{
		<MokaEmptyState Compact
						Icon="DevToolIcons.Hash"
						Title="No hashes yet"
						Description="@(_source == HashSource.Text ? "The hashes follow the text as it changes." : "Choose a file to hash it with every algorithm in one pass.")" />
	}
</SectionFrame>
