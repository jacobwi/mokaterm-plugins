@inherits DevToolViewBase

<SectionFrame Title="JWT" Said="@Summary">
	<Actions>
		@if (_token.Length > 0)
		{
			<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Xs" StartIcon="MokaIcons.Navigation.Close" OnClick="ClearAsync">Clear</MokaButton>
		}
	</Actions>
	<ChildContent>
		<MokaCard Inner Outlined>
			<SecretField Label="Token"
						 HelperText="Read here and sent nowhere. The token stays hidden while you type, and the claims until you show them."
						 Value="@_token"
						 ValueChanged="OnTokenChangedAsync"
						 Placeholder="Paste a token (eyJ...) or an Authorization header" />
		</MokaCard>

		@if (_error is { } error)
		{
			<MokaAlert Severity="MokaToastSeverity.Error" Title="Not a JWT" Dense>@error</MokaAlert>
		}

		@if (_jwt is { } jwt)
		{
			<JwtTokenView Token="jwt" Verification="_verification">
				<SignatureActions>
					@if (Family is JwtFamily.Hmac or JwtFamily.PublicKey)
					{
						<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Xs" StartIcon="MokatermIcons.ShieldCheck" Disabled="_verifying" Loading="_verifying" OnClick="VerifyAsync">Verify</MokaButton>
					}
				</SignatureActions>
				<SignatureContent>
					@switch (Family)
					{
						case JwtFamily.Hmac:
							<MokaGrid ColumnsValue="minmax(0, 1fr) auto" Gap="MokaSpacingScale.Sm" AlignItems="MokaAlign.End">
								<SecretField Label="Secret" Value="@_secret" ValueChanged="OnSecretChanged" Placeholder="@($"The shared secret for {jwt.Algorithm}")" />
								<EnumSegmentedControl TEnum="KeyFormat" Value="_secretFormat" ValueChanged="OnSecretFormatChanged" Options="SecretFormats" AriaLabel="Secret format" />
							</MokaGrid>
							break;
						case JwtFamily.PublicKey:
							<MokaTextArea Mono
										  Label="Public key"
										  Value="@_publicKey"
										  ValueChanged="OnPublicKeyChanged"
										  Rows="4"
										  Placeholder="@($"Paste the public key or certificate (PEM), or a JWK or JWK set, for {jwt.Algorithm}")"
										  Size="MokaSize.Sm"
										  spellcheck="false"
										  autocomplete="off"
										  aria-label="Public key" />
							break;
					}

					@if (_verification is { } verification)
					{
						<ResultLine Title="@VerdictText(verification.Verdict)" Tone="@VerdictTone(verification.Verdict)">@verification.Message</ResultLine>
						@foreach (string note in verification.Notes)
						{
							<MokaCaption>@note</MokaCaption>
						}
					}
					else
					{
						<ResultLine Title="Not checked" Tone="ResultTone.Plain">@NotCheckedText</ResultLine>
					}
				</SignatureContent>
			</JwtTokenView>
		}
		else if (_error is null)
		{
			<MokaEmptyState Icon="DevToolIcons.Jwt"
							Title="No token yet"
							Description="Paste a JWT to read its header and claims, see when it expires, and check its signature with a secret, a public key, a certificate or a JWK." />
		}
	</ChildContent>
</SectionFrame>
