@inherits DevToolViewBase

<SectionFrame Title="Time" Said="@Summary">
	<Actions>
		<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Xs" StartIcon="DevToolIcons.Time" OnClick="SetNow">Now</MokaButton>
	</Actions>
	<ChildContent>
		<MokaCard Inner Outlined>
			<MokaGrid ColumnsValue="minmax(0, 1fr) auto" Gap="MokaSpacingScale.Sm" AlignItems="MokaAlign.Start">
				<MokaTextField Mono
							   Label="Unix time or date"
							   HelperText="@ReadAsText"
							   ErrorText="@_error"
							   Value="@_text"
							   ValueChanged="OnTextChanged"
							   Placeholder="1715000000, 1715000000000, 2024-05-06T12:53:20Z or Mon, 06 May 2024 12:53:20 GMT"
							   Size="MokaSize.Sm"
							   spellcheck="false"
							   autocomplete="off"
							   aria-label="Unix time or date" />
				<MokaFlexbox Gap="MokaSpacingScale.Xxs">
					<MokaLabel Micro>Unit of a number</MokaLabel>
					<EnumSegmentedControl TEnum="EpochChoice" Value="_unit" ValueChanged="OnUnitChanged" Options="Units" AriaLabel="Unit of a number" />
				</MokaFlexbox>
			</MokaGrid>
		</MokaCard>

		@if (_reading is { } reading)
		{
			<TimeReadingView Reading="reading" />
		}
		else if (_error is null)
		{
			<MokaEmptyState Compact
							Icon="DevToolIcons.Time"
							Title="No time yet"
							Description="Type a Unix time in any unit or a written date, or press Now. Zones added below show the same moment." />
		}

		<MokaCard Inner Outlined Title="Time zones" Subtitle="@ZoneCount">
			<MokaFlexbox Gap="MokaSpacingScale.Md">
				<MokaGrid ColumnsValue="minmax(0, 1fr) minmax(0, 1fr) auto" Gap="MokaSpacingScale.Sm" AlignItems="MokaAlign.End">
					<MokaSelect TValue="string"
								Label="From this machine's list"
								Items="ZoneCatalog.Ids"
								Value="_zonePick"
								ValueChanged="AddPicked"
								Searchable
								Placeholder="Pick a zone"
								Size="MokaSize.Sm"
								aria-label="Add a time zone" />
					<div @onkeydown="OnZoneKey">
						<MokaTextField Mono
									   Label="Or an IANA name"
									   Value="@_zoneText"
									   ValueChanged="@(value => _zoneText = value ?? "")"
									   Placeholder="Asia/Kolkata"
									   Size="MokaSize.Sm"
									   spellcheck="false"
									   autocomplete="off"
									   aria-label="IANA time zone name" />
					</div>
					<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm" StartIcon="MokaIcons.Action.Add" Disabled="@(_zoneText.Trim().Length == 0)" OnClick="AddTyped">Add</MokaButton>
				</MokaGrid>
				@if (_zoneError is { } zoneError)
				{
					<MokaAlert Severity="MokaToastSeverity.Warning" Dense>@zoneError</MokaAlert>
				}
				<ZoneTable Zones="_zones" Instant="@_reading?.Instant" OnRemove="Remove" />
			</MokaFlexbox>
		</MokaCard>
	</ChildContent>
</SectionFrame>
