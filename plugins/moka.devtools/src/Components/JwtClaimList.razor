@inherits DevToolViewBase
@implements IDisposable

@* A token's payload as JSON with every claim's value hidden until shown, one at a time or all at once. Values are copied
   through the host's secret copy. *@
<section class="dt-claims" aria-label="Payload">
	<div class="dt-claims-head">
		<span class="dt-claims-title">Payload</span>
		<span class="dt-claims-count">@(Claims.Count == 1 ? "1 claim" : string.Create(CultureInfo.CurrentCulture, $"{Claims.Count} claims"))</span>
		<span class="dt-claims-gap"></span>
		<MokaButton Variant="MokaVariant.Text"
					Color="MokaColor.Surface"
					Size="MokaSize.Xs"
					StartIcon="@(AllShown ? MokaIcons.Toggle.EyeOff : MokaIcons.Toggle.Eye)"
					OnClick="ToggleAll">
			@(AllShown ? "Hide all" : "Show all")
		</MokaButton>
		@if (PayloadJson is { } payload)
		{
			<MokaButton Variant="MokaVariant.Outlined"
						Size="MokaSize.Xs"
						StartIcon="MokaIcons.Content.Copy"
						OnClick="@(() => CopySecretAsync(payload, "Payload"))">
				Copy
			</MokaButton>
		}
	</div>
	<div class="dt-claims-body">
		<div class="dt-claim-brace">{</div>
		@for (int index = 0; index < Claims.Count; index++)
		{
			JwtClaim claim = Claims[index];
			bool shown = _shown.Contains(index);
			bool last = index == Claims.Count - 1;
			int number = index;
			<div class="dt-claim" @key="index">
				<button type="button"
						class="dt-claim-button"
						title="@((shown ? "Hide " : "Show ") + claim.Name)"
						aria-label="@((shown ? "Hide " : "Show ") + claim.Name)"
						aria-pressed="@(shown ? "true" : "false")"
						@onclick="() => Toggle(number)">
					<MokaIcon Icon="@(shown ? MokaIcons.Toggle.EyeOff : MokaIcons.Toggle.Eye)" Size="MokaSize.Xs" />
				</button>
				<span class="dt-claim-text">
					<span class="dt-claim-name">"@claim.Name"</span><span>: </span>
					@if (shown)
					{
						<span class="dt-claim-value">@Indent(claim.Json)</span>
					}
					else
					{
						<span class="dt-claim-mask" title="Hidden">@Mask</span>
					}
					@if (!last)
					{
						<span>,</span>
					}
				</span>
				@if (shown)
				{
					<button type="button" class="dt-claim-button" title="@("Copy " + claim.Name)" aria-label="@("Copy " + claim.Name)" @onclick="() => CopyClaimAsync(claim)">
						<MokaIcon Icon="MokaIcons.Content.Copy" Size="MokaSize.Xs" />
					</button>
				}
			</div>
		}
		<div class="dt-claim-brace">}</div>
	</div>
</section>

@code {
	/// <summary>What a hidden value shows: the same width whatever it hides, so its length gives nothing away.</summary>
	public const string Mask = "••••••••";

	private readonly HashSet<int> _shown = [];
	private IReadOnlyList<JwtClaim>? _shownFor;

	[Parameter, EditorRequired]
	public IReadOnlyList<JwtClaim> Claims { get; set; } = [];

	/// <summary>The whole payload, for Copy; null shows no Copy.</summary>
	[Parameter]
	public string? PayloadJson { get; set; }

	private bool AllShown => Claims.Count > 0 && _shown.Count == Claims.Count;

	public void Dispose() => _shown.Clear();

	protected override void OnParametersSet()
	{
		// A new token starts hidden again.
		if (!ReferenceEquals(_shownFor, Claims))
		{
			_shown.Clear();
			_shownFor = Claims;
		}
	}

	// A nested value keeps its own indentation under the claim's name.
	private static string Indent(string json) => json.Replace("\n", "\n  ", StringComparison.Ordinal);

	private void Toggle(int index)
	{
		if (!_shown.Add(index))
		{
			_shown.Remove(index);
		}
	}

	private void ToggleAll()
	{
		if (AllShown)
		{
			_shown.Clear();
		}
		else
		{
			_shown.UnionWith(Enumerable.Range(0, Claims.Count));
		}
	}

	// A string claim is copied as its text, without the JSON quotes and escapes.
	private Task CopyClaimAsync(JwtClaim claim) => CopySecretAsync(
		claim.Kind == System.Text.Json.JsonValueKind.String ? System.Text.Json.JsonSerializer.Deserialize<string>(claim.Json) ?? "" : claim.Json,
		claim.Name);
}
