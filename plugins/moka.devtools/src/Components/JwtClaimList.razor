@inherits DevToolViewBase
@implements IDisposable

@* A token's claims as a table with every value hidden until shown, one at a time or all at once. Values are copied
   through the host's secret copy. *@
<MokaCard Inner Outlined Title="Claims" Subtitle="@CountText">
	<HeaderActions>
		<MokaFlexbox Direction="MokaDirection.Row" Align="MokaAlign.Center" Gap="MokaSpacingScale.Xs">
			<MokaButton Variant="MokaVariant.Text"
						Color="MokaColor.Surface"
						Size="MokaSize.Xs"
						StartIcon="@(AllShown ? MokaIcons.Toggle.EyeOff : MokaIcons.Toggle.Eye)"
						OnClick="ToggleAll">
				@(AllShown ? "Hide all" : "Show all")
			</MokaButton>
			@if (PayloadJson is { } payload)
			{
				<IconButton Icon="MokaIcons.Content.Copy"
							Label="Copy the payload"
							Color="MokaColor.Primary"
							Size="MokaSize.Xs"
							Position="MokaTooltipPosition.BottomEnd"
							OnClick="@(() => CopySecretAsync(payload, "Payload"))" />
			}
		</MokaFlexbox>
	</HeaderActions>
	<ChildContent>
		<MokaTable TItem="ClaimRow"
				   Items="_rows"
				   ItemKey="@(row => row.Index)"
				   ShowToolbar="false"
				   ShowPagination="false"
				   Dense
				   Bleed
				   Label="Claims"
				   ActionsColumnTitle=""
				   ActionsColumnWidth="72px">
			<ChildContent>
				<MokaColumn Title="Claim" Field="row => row.Index" Sortable="false" Width="140px">
					<CellTemplate Context="row">
						<MokaText Element="span" Size="MokaSize.Sm" Mono Weight="MokaFontWeight.Semibold">@row.Claim.Name</MokaText>
					</CellTemplate>
				</MokaColumn>
				<MokaColumn Title="Meaning" Field="row => row.Index" Sortable="false" Width="160px">
					<CellTemplate Context="row">
						<MokaCaption>@(JwtClaimNames.Describe(row.Claim.Name) ?? "")</MokaCaption>
					</CellTemplate>
				</MokaColumn>
				<MokaColumn Title="Value" Field="row => row.Index" Sortable="false">
					<CellTemplate Context="row">
						@if (_shown.Contains(row.Index))
						{
							<MokaText Element="span" Size="MokaSize.Sm" Mono><span class="dt-claim-value">@row.Claim.Json</span></MokaText>
						}
						else
						{
							<MokaText Element="span" Size="MokaSize.Sm" Mono><span class="dt-claim-mask" aria-label="Hidden">@Mask</span></MokaText>
						}
					</CellTemplate>
				</MokaColumn>
			</ChildContent>
			<RowActions Context="row">
				<MokaFlexbox Direction="MokaDirection.Row" Align="MokaAlign.Center" Justify="MokaJustify.End" Gap="MokaSpacingScale.Xxs">
					@if (_shown.Contains(row.Index))
					{
						<IconButton Icon="MokaIcons.Content.Copy"
									Label="@($"Copy {row.Claim.Name}")"
									Color="MokaColor.Primary"
									Size="MokaSize.Xs"
									OnClick="@(() => CopyClaimAsync(row.Claim))" />
					}
					<IconButton Icon="@(_shown.Contains(row.Index) ? MokaIcons.Toggle.EyeOff : MokaIcons.Toggle.Eye)"
								Label="@((_shown.Contains(row.Index) ? "Hide " : "Show ") + row.Claim.Name)"
								Pressed="@_shown.Contains(row.Index)"
								Size="MokaSize.Xs"
								Position="MokaTooltipPosition.BottomEnd"
								OnClick="@(() => Toggle(row.Index))" />
				</MokaFlexbox>
			</RowActions>
		</MokaTable>
	</ChildContent>
</MokaCard>

@code {
	/// <summary>What a hidden value shows: the same width whatever it hides, so its length gives nothing away.</summary>
	public const string Mask = "••••••••";

	private readonly HashSet<int> _shown = [];
	private IReadOnlyList<JwtClaim>? _shownFor;
	private IReadOnlyList<ClaimRow> _rows = [];

	[Parameter, EditorRequired]
	public IReadOnlyList<JwtClaim> Claims { get; set; } = [];

	/// <summary>The whole payload, for Copy; null shows no Copy.</summary>
	[Parameter]
	public string? PayloadJson { get; set; }

	private bool AllShown => Claims.Count > 0 && _shown.Count == Claims.Count;

	private string CountText => (Claims.Count, _shown.Count) switch
	{
		(1, 0) => "1 claim, hidden until shown",
		(_, 0) => string.Create(CultureInfo.CurrentCulture, $"{Claims.Count} claims, hidden until shown"),
		(1, _) => "1 claim, shown",
		var (total, shown) => string.Create(CultureInfo.CurrentCulture, $"{total} claims, {shown} shown"),
	};

	public void Dispose() => _shown.Clear();

	protected override void OnParametersSet()
	{
		// A new token starts hidden again.
		if (!ReferenceEquals(_shownFor, Claims))
		{
			_shown.Clear();
			_shownFor = Claims;
			_rows = [.. Claims.Select((claim, index) => new ClaimRow(index, claim))];
		}
	}

	private void Toggle(int index)
	{
		if (!_shown.Add(index))
		{
			_shown.Remove(index);
		}
	}

	private void ToggleAll()
	{
		if (AllShown)
		{
			_shown.Clear();
		}
		else
		{
			_shown.UnionWith(Enumerable.Range(0, Claims.Count));
		}
	}

	// A string claim is copied as its text, without the JSON quotes and escapes.
	private Task CopyClaimAsync(JwtClaim claim) => CopySecretAsync(
		claim.Kind == System.Text.Json.JsonValueKind.String ? System.Text.Json.JsonSerializer.Deserialize<string>(claim.Json) ?? "" : claim.Json,
		claim.Name);

	private sealed record ClaimRow(int Index, JwtClaim Claim);
}
