@inherits DevToolViewBase

@* A decoded token: the figures it is about, its claims (hidden until shown), its times, its header and its signature,
   with the section's own check of the signature drawn inside that card. *@
@foreach (string note in Token.Notes)
{
	<MokaAlert Severity="MokaToastSeverity.Info" Dense>@note</MokaAlert>
}

@if (Token.IsUnsigned)
{
	<MokaCallout Type="MokaCalloutType.Caution" Title="This token is not signed">
		Its algorithm is none, so anyone can write one like it. Never accept it.
	</MokaCallout>
}

<MokaGrid MinColumn="190px" Gap="MokaSpacingScale.Md">
	<MokaStat Tile Label="Algorithm" Value="@(Token.Algorithm ?? "None named")" HelpText="@FamilyText" Color="@AlgorithmColor" />
	<MokaStat Tile Label="Validity" Value="@Validity.Text" HelpText="@Validity.Detail" Color="@Validity.Color" />
	<MokaStat Tile Label="Claims" Value="@Token.Claims.Count.ToString(CultureInfo.CurrentCulture)" HelpText="@ClaimsText" />
	<MokaStat Tile Label="Signature" Value="@Signature.Text" HelpText="@Signature.Detail" Color="@Signature.Color" />
</MokaGrid>

@if (Token.Claims.Count > 0)
{
	<JwtClaimList Claims="Token.Claims" PayloadJson="@Token.PayloadJson" />
}
else if (Token.PayloadJson is { } payloadJson)
{
	<CodeOutput Title="Payload" Text="@payloadJson" Language="json" Secret CopyName="Payload" />
}
else if (Token.PayloadText is { } payloadText)
{
	<CodeOutput Title="Payload" Detail="Not JSON" Text="@payloadText" Secret CopyName="Payload" />
}

<MokaGrid MinColumn="320px" Gap="MokaSpacingScale.Md" AlignItems="MokaAlign.Start">
	<CodeOutput Title="Header" Text="@Token.HeaderJson" Language="json" CopyName="Header" />
	@if (Token.Times.Count > 0)
	{
		<MokaCard Inner Outlined Title="Times">
			<MokaDataList Dense Orientation="MokaDirection.Row" Items="TimeItems" />
		</MokaCard>
	}
</MokaGrid>

<MokaCard Inner Outlined Title="Signature" Subtitle="@SignatureSize" HeaderActions="SignatureActions">
	<MokaFlexbox Gap="MokaSpacingScale.Md">
		<MokaDataList Dense Orientation="MokaDirection.Row" Items="SignatureItems" />
		@SignatureContent
	</MokaFlexbox>
</MokaCard>

@code {
	[Parameter, EditorRequired]
	public JwtToken Token { get; set; } = default!;

	/// <summary>The last check of the signature; null while nothing was checked.</summary>
	[Parameter]
	public JwtVerification? Verification { get; set; }

	/// <summary>The signature card's header buttons: Verify.</summary>
	[Parameter]
	public RenderFragment? SignatureActions { get; set; }

	/// <summary>What the signature card shows under the signature's bytes: the key to check with and the verdict.</summary>
	[Parameter]
	public RenderFragment? SignatureContent { get; set; }

	private JwtFamily Family => JwtVerifier.FamilyOf(Token.Algorithm);

	private string FamilyText => Family switch
	{
		JwtFamily.Hmac => "Shared secret (HMAC)",
		JwtFamily.PublicKey => "Public key",
		JwtFamily.None => "Not signed",
		_ => Token.Algorithm is null ? "The header names none" : "Not checked here",
	};

	private MokaColor? AlgorithmColor => Token.IsUnsigned ? MokaColor.Error : Token.Algorithm is null ? MokaColor.Warning : null;

	private string ClaimsText => Token.Claims.Count > 0 ? "Values hidden until shown" : Token.PayloadJson is not null ? "The payload is not an object" : "The payload is not JSON";

	private string SignatureSize => Token.Signature.Length == 1 ? "1 byte" : string.Create(CultureInfo.CurrentCulture, $"{Token.Signature.Length:N0} bytes");

	private (string Text, string Detail, MokaColor? Color) Validity
	{
		get
		{
			JwtValidity validity = JwtValidity.Of(Token, Now);
			MokaColor color = validity.State switch
			{
				JwtValidityState.ValidNow => MokaColor.Success,
				JwtValidityState.Expired => MokaColor.Error,
				_ => MokaColor.Warning,
			};
			return (validity.Text, validity.Detail, color);
		}
	}

	private (string Text, string Detail, MokaColor? Color) Signature => (Family, Verification?.Verdict) switch
	{
		(JwtFamily.None, _) => ("Unsigned", "alg is none", MokaColor.Error),
		(_, JwtVerdict.Verified) => ("Verified", "It matches the key", MokaColor.Success),
		(_, JwtVerdict.Failed) => ("Failed", "It does not match the key", MokaColor.Error),
		(JwtFamily.Hmac or JwtFamily.PublicKey, _) => ("Not checked", "Verify it below", null),
		_ => ("Not checked", "Not checked here", null),
	};

	private IReadOnlyList<MokaDataListItem> TimeItems
	{
		get
		{
			DateTimeOffset now = Now;
			List<MokaDataListItem> items = [];
			foreach (JwtTime time in Token.Times)
			{
				string label = time.Claim switch
				{
					"exp" => "Expires, exp",
					"nbf" => "Not before, nbf",
					"iat" => "Issued, iat",
					_ => "Signed in, auth_time",
				};

				items.Add(time.When is { } when
					? new MokaDataListItem(label, ValueContent: Mono(TimeFormats.IsoUtc(when), note: $"{Relative(time.Claim, when, now)}. Local {TimeFormats.InZone(when, TimeZoneInfo.Local)}"))
					: new MokaDataListItem(label, time.Problem ?? ""));
			}

			return items;
		}
	}

	private IReadOnlyList<MokaDataListItem> SignatureItems =>
	[
		new("Base64url", ValueContent: Token.SignatureText.Length > 0 ? Mono(Token.SignatureText, "Copy the signature") : Empty),
		new("Hex", ValueContent: Token.Signature.Length > 0 ? Mono(HexText.Format(Token.Signature), "Copy the signature as hex") : Empty),
	];

	private static RenderFragment Empty => @<MokaCaption>(empty)</MokaCaption>;

	private static RenderFragment Mono(string value, string? copyLabel = null, string? note = null) =>
		@<MonoValue Text="@value" CopyLabel="@copyLabel" Note="@note" />;

	private static string Relative(string claim, DateTimeOffset when, DateTimeOffset now)
	{
		string span = RelativeTime.Span(when - now);
		bool past = when <= now;
		return claim switch
		{
			"exp" => past ? $"Expired {span} ago" : $"Expires in {span}",
			"nbf" => past ? $"Valid since {span} ago" : $"Not valid for another {span}",
			"iat" => past ? $"Issued {span} ago" : $"Issued {span} in the future",
			_ => past ? $"Signed in {span} ago" : $"{span} in the future",
		};
	}
}
