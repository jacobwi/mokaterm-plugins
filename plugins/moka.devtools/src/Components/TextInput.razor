@inherits DevToolViewBase

@* A labelled text box with Clear and, when asked, Open file. A file too long for the box (or not text, where bytes are
   taken) stays a file and shows as a chip, since every keystroke in a box sends all of it. *@
<div class="dt-input">
	<div class="dt-input-head">
		<span class="dt-input-label">@Label</span>
		@if (!Value.IsEmpty && !Value.IsFile)
		{
			<span class="dt-input-count">@Count</span>
		}
		<span class="dt-input-gap"></span>
		@Actions
		@if (AllowFile)
		{
			<MokaButton Variant="MokaVariant.Text"
						Color="MokaColor.Surface"
						Size="MokaSize.Xs"
						StartIcon="MokatermIcons.FolderOpen"
						Disabled="Disabled"
						OnClick="OpenAsync">
				Open file
			</MokaButton>
		}
		@if (!Value.IsEmpty)
		{
			<MokaButton Variant="MokaVariant.Text"
						Color="MokaColor.Surface"
						Size="MokaSize.Xs"
						StartIcon="MokaIcons.Navigation.Close"
						Disabled="Disabled"
						OnClick="ClearAsync">
				Clear
			</MokaButton>
		}
	</div>

	@if (Value.IsFile)
	{
		<div class="dt-input-file">
			<MokaIcon Icon="MokaIcons.File.Document" Size="MokaSize.Xs" />
			<span class="dt-input-file-name" title="@Value.FileName">@Value.FileName</span>
			<span class="dt-input-file-size">@FileDetail</span>
		</div>
	}
	else
	{
		<MokaTextArea Class="@(Mono ? "dt-input-text dt-input-text--mono" : "dt-input-text")"
					  Value="@Value.Text"
					  ValueChanged="OnTextChangedAsync"
					  Rows="Rows"
					  Placeholder="@Placeholder"
					  Disabled="Disabled"
					  Size="MokaSize.Sm"
					  spellcheck="false"
					  autocomplete="off"
					  autocapitalize="off"
					  aria-label="@Label" />
	}

	@if (Hint is { Length: > 0 } hint)
	{
		<span class="dt-input-hint">@hint</span>
	}
</div>

@code {
	[Parameter, EditorRequired]
	public string Label { get; set; } = "";

	[Parameter]
	public TextValue Value { get; set; } = TextValue.Empty;

	[Parameter]
	public EventCallback<TextValue> ValueChanged { get; set; }

	[Parameter]
	public string? Placeholder { get; set; }

	[Parameter]
	public string? Hint { get; set; }

	[Parameter]
	public int Rows { get; set; } = 6;

	[Parameter]
	public bool Mono { get; set; } = true;

	[Parameter]
	public bool AllowFile { get; set; }

	/// <summary>Takes a file that is not UTF-8 text as bytes instead of refusing it.</summary>
	[Parameter]
	public bool AllowBytes { get; set; }

	/// <summary>What the file should be, for the message when it is too large: "a JSON or YAML file".</summary>
	[Parameter]
	public string FileWhat { get; set; } = "text";

	[Parameter]
	public bool Disabled { get; set; }

	/// <summary>Buttons of the caller's own, drawn before Open file and Clear.</summary>
	[Parameter]
	public RenderFragment? Actions { get; set; }

	private string Count => Value.Text.Length == 1 ? "1 char" : string.Create(CultureInfo.CurrentCulture, $"{Value.Text.Length:N0} chars");

	private string FileDetail => Value.Bytes is not null ? $"{Size(Value.Length)}, not text" : string.Create(CultureInfo.CurrentCulture, $"{Value.Text.Length:N0} chars");

	private Task OnTextChangedAsync(string? text) => ValueChanged.InvokeAsync(new TextValue { Text = text ?? "" });

	private Task ClearAsync() => ValueChanged.InvokeAsync(TextValue.Empty);

	private async Task OpenAsync()
	{
		if (await OpenFileAsync(FileWhat, TextLimits.MaxTextFileBytes) is not { } file)
		{
			return;
		}

		if (!StrictUtf8.TryDecode(file.Bytes, out string? text))
		{
			if (AllowBytes)
			{
				await ValueChanged.InvokeAsync(new TextValue { Bytes = file.Bytes, FileName = file.Name });
			}
			else
			{
				Notify(Mokaterm.Abstractions.Interaction.NoticeSeverity.Error, $"{file.Name} is not UTF-8 text.");
			}

			return;
		}

		text = StrictUtf8.WithoutBom(text);
		await ValueChanged.InvokeAsync(text.Length <= BoxChars
			? new TextValue { Text = text }
			: new TextValue { Text = text, FileName = file.Name });
	}
}
