@* Moka's password field for a token, a secret or a key: hidden while typed, with its show toggle, and read in mono
   once shown. *@
<div class="dt-secret">
	<MokaPasswordField Label="@Label"
					   HelperText="@HelperText"
					   Value="@Value"
					   ValueChanged="ValueChanged"
					   Placeholder="@Placeholder"
					   Size="MokaSize.Sm"
					   Disabled="Disabled"
					   spellcheck="false"
					   autocomplete="off"
					   aria-label="@Label" />
</div>

@code {
	[Parameter, EditorRequired]
	public string Label { get; set; } = "";

	[Parameter]
	public string? HelperText { get; set; }

	[Parameter]
	public string Value { get; set; } = "";

	[Parameter]
	public EventCallback<string> ValueChanged { get; set; }

	[Parameter]
	public string? Placeholder { get; set; }

	[Parameter]
	public bool Disabled { get; set; }
}
