@* A line diff as diff prints it: one hunk per run of changes, each under its header, with the unchanged lines between
   them counted rather than drawn, and past MaxRows the rest counted too. *@
<MokaCard Inner Outlined Title="Differences" Subtitle="@HunkCount">
	<HeaderActions>
		<MokaFlexbox Direction="MokaDirection.Row" Align="MokaAlign.Center" Gap="MokaSpacingScale.Xs">
			<MokaTag Text="@Removed" Color="MokaColor.Error" Size="MokaSize.Xs" />
			<MokaTag Text="@Added" Color="MokaColor.Success" Size="MokaSize.Xs" />
		</MokaFlexbox>
	</HeaderActions>
	<ChildContent>
		<MokaFlexbox Gap="MokaSpacingScale.Sm">
			@foreach ((DiffHunk hunk, IReadOnlyList<MokaDiffLine> lines) in _hunks)
			{
				@if (hunk.SkippedBefore > 0)
				{
					<MokaCaption>@Unchanged(hunk.SkippedBefore)</MokaCaption>
				}
				<MokaFlexbox Gap="MokaSpacingScale.Xxs">
					<MokaText Element="span" Size="MokaSize.Xs" Mono Color="MokaColor.Info">@hunk.Header</MokaText>
					<MokaDiffViewer Lines="lines" Wrap />
				</MokaFlexbox>
			}
			@if (_layout.SkippedAfter > 0)
			{
				<MokaCaption>@Unchanged(_layout.SkippedAfter)</MokaCaption>
			}
			@if (_layout.RowsLeftOut > 0)
			{
				<MokaCaption>@string.Create(CultureInfo.CurrentCulture, $"{_layout.RowsLeftOut:N0} more changed or nearby lines are not drawn.")</MokaCaption>
			}
		</MokaFlexbox>
	</ChildContent>
</MokaCard>

@code {
	/// <summary>Rows drawn at most: past this a page of rows costs more to lay out than anyone reads.</summary>
	public const int MaxRows = 3000;

	private DiffResult? _laidOut;
	private DiffLayout _layout = new([], 0, 0);
	private IReadOnlyList<(DiffHunk Hunk, IReadOnlyList<MokaDiffLine> Lines)> _hunks = [];

	[Parameter, EditorRequired]
	public DiffResult Diff { get; set; } = default!;

	private string Removed => string.Create(CultureInfo.CurrentCulture, $"-{Diff.Removed:N0}");

	private string Added => string.Create(CultureInfo.CurrentCulture, $"+{Diff.Added:N0}");

	private string HunkCount => _layout.Hunks.Count == 1 ? "1 change" : string.Create(CultureInfo.CurrentCulture, $"{_layout.Hunks.Count:N0} changes");

	protected override void OnParametersSet()
	{
		if (!ReferenceEquals(_laidOut, Diff))
		{
			_laidOut = Diff;
			_layout = DiffLayout.Of(Diff, MaxRows);
			_hunks = [.. _layout.Hunks.Select(hunk => (hunk, ToMoka(hunk)))];
		}
	}

	private static IReadOnlyList<MokaDiffLine> ToMoka(DiffHunk hunk) =>
	[
		.. hunk.Lines.Select(line => new MokaDiffLine(
			line.Kind switch
			{
				DiffKind.Added => MokaDiffLineKind.Added,
				DiffKind.Removed => MokaDiffLineKind.Removed,
				_ => MokaDiffLineKind.Unchanged,
			},
			line.Text)),
	];

	private static string Unchanged(int count) => count == 1 ? "1 unchanged line" : string.Create(CultureInfo.CurrentCulture, $"{count:N0} unchanged lines");
}
