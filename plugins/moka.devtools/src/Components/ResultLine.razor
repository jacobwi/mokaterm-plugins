@* One verdict: a short title and a sentence, coloured for good, bad, a warning or plain news. *@
<MokaAlert Severity="Severity" Title="@Title" Dense>@ChildContent</MokaAlert>

@code {
	[Parameter, EditorRequired]
	public string Title { get; set; } = "";

	[Parameter]
	public ResultTone Tone { get; set; }

	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	private MokaToastSeverity Severity => Tone switch
	{
		ResultTone.Good => MokaToastSeverity.Success,
		ResultTone.Bad => MokaToastSeverity.Error,
		ResultTone.Warning => MokaToastSeverity.Warning,
		_ => MokaToastSeverity.Info,
	};
}
