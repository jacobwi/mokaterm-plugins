@* What every section starts with: Moka's page header over a body that scrolls on its own, so the header and its
   actions stay in view. *@
<section class="dt-frame" aria-label="@Title">
	<MokaPageHeader Class="dt-frame-head" Title="@Title" Said="@Said" Actions="Actions" />
	@Tabs
	<div class="dt-frame-body">
		<MokaFlexbox Gap="MokaSpacingScale.Md">
			@ChildContent
		</MokaFlexbox>
	</div>
</section>

@code {
	[Parameter, EditorRequired]
	public string Title { get; set; } = "";

	/// <summary>One line under the title: what the section holds now.</summary>
	[Parameter]
	public string? Said { get; set; }

	[Parameter]
	public RenderFragment? Actions { get; set; }

	/// <summary>A row of tabs between the header and the body, which stays in view with the header.</summary>
	[Parameter]
	public RenderFragment? Tabs { get; set; }

	[Parameter]
	public RenderFragment? ChildContent { get; set; }
}
