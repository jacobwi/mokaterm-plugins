@inherits SessionSectionBase
@using Moka.Kubernetes.Server

<KubePage Title="Logs"
		  Said="@Summary"
		  PrimaryText="@(Running ? "Stop" : "Fetch")"
		  PrimaryIcon="@(Running ? KubernetesIcons.Stop : KubernetesIcons.Start)"
		  PrimaryDisabled="@(Busy && !Running)"
		  PrimaryTitle="@PrimaryTitle"
		  OnPrimary="PrimaryAsync">
	<Subhead>
		<SessionOriginNote Session="Session" />
	</Subhead>
	<ChildContent>
		<MokaCard Inner Title="Source" @onkeydown="OnKeyAsync">
			<MokaFlexbox Gap="MokaSpacingScale.Md">
				<MokaGrid ColumnsValue="minmax(0, 2fr) minmax(0, 1fr)" Gap="MokaSpacingScale.Sm">
					<MokaTextField Label="Pod"
								   Value="@_pod"
								   ValueChanged="@(value => _pod = value ?? "")"
								   Placeholder="web-6799fc88d1-kx4t2"
								   Size="MokaSize.Sm"
								   Mono
								   spellcheck="false"
								   autocomplete="off"
								   Disabled="Busy" />
					<MokaSelect TValue="string"
								Label="Container"
								Items="_containers"
								Value="@Container"
								ValueChanged="OnContainerChanged"
								ValueSelector="ContainerLabel"
								Placeholder="First container"
								Searchable="@(_containers.Count > 8)"
								Size="MokaSize.Sm"
								Disabled="Busy" />
				</MokaGrid>
				<MokaFlexbox Direction="MokaDirection.Row" Wrap Align="MokaAlign.Center" Gap="MokaSpacingScale.Lg">
					<MokaSwitch Label="Follow" Value="_following" ValueChanged="OnFollowChanged" Disabled="Busy" />
					<MokaSwitch Label="Previous logs" Value="_previous" ValueChanged="OnPreviousChanged" Disabled="Busy" />
				</MokaFlexbox>
				<MokaCaption>
					The tail of one container's log, newest at the bottom. Follow asks kubectl for new lines every 3 seconds - a poll, not a stream. Previous reads what the container wrote before its latest start, when it restarted.
				</MokaCaption>
			</MokaFlexbox>
		</MokaCard>

		@if (_error is { } error)
		{
			<MokaAlert Severity="MokaToastSeverity.Error" Dense>@error</MokaAlert>
		}
		@if (Offline)
		{
			<MokaAlert Severity="MokaToastSeverity.Info" Dense>The session is not connected. Reconnect it to read logs again.</MokaAlert>
		}

		@if (_rows.Count > 0)
		{
			<MokaFlexbox Direction="MokaDirection.Row" Wrap Align="MokaAlign.Center" Gap="MokaSpacingScale.Sm">
				<MokaTag Text="@LinesText" />
				@if (_following)
				{
					<MokaStatusDot Size="MokaSize.Xs" Color="MokaColor.Success" Pulse Uppercase="false" Label="Following every 3 s" />
				}
				@if (_lines.Dropped > 0)
				{
					<MokaCaption>The oldest @Count(_lines.Dropped) are counted but no longer listed.</MokaCaption>
				}
				@if (_lines.Skipped > 0)
				{
					<MokaCaption>@Count(_lines.Skipped) brought again by a poll were not listed twice.</MokaCaption>
				}
				<span class="mk8s-gap"></span>
				<div class="mk8s-filter">
					<MokaSearchInput Value="@_filter" ValueChanged="OnFilterChanged" Placeholder="Filter lines" Debounce="150" Size="MokaSize.Sm" aria-label="Filter lines" />
				</div>
				<CopyButton Text="@_lines.AllText()" Label="Copy log" Position="MokaTooltipPosition.BottomEnd" />
			</MokaFlexbox>
			<div class="mk8s-fill">
				@if (Shown.Count > 0)
				{
					<PodLogView Lines="Shown" Title="@SourceText" />
				}
				else
				{
					<MokaEmptyState Icon="KubernetesIcons.Logs" Title="No line matches" Description="@NoMatchText" Compact />
				}
			</div>
		}
		else if (!Busy)
		{
			<MokaEmptyState Icon="KubernetesIcons.Logs"
							Title="@(_read ? "Nothing written" : "No log read yet")"
							Description="@(_read
								? "The container wrote nothing in the lines kubectl brought."
								: "Name a pod and fetch its log; the pods tab can hand one over with its Logs action.")"
							Compact />
		}
		else
		{
			<MokaSkeleton Lines="6" />
		}
	</ChildContent>
</KubePage>
