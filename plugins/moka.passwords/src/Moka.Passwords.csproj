<Project Sdk="Microsoft.NET.Sdk.Razor">

	<!--
		Password Generator for Mokaterm: one app tool that makes passwords, passphrases and PINs, rates the settings that
		made them and copies them so the clipboard clears, plus a settings page for what the tool starts with. The
		generators and the strength maths are plain classes under Generation and Strength, which the tool and the tests
		go through. Every build writes bin/<configuration>/net10.0/moka.passwords-<version>.mokaplugin.
	-->
	<PropertyGroup>
		<AssemblyName>Moka.Passwords</AssemblyName>
		<RootNamespace>Moka.Passwords</RootNamespace>
		<Version>1.0.0</Version>
	</PropertyGroup>

	<PropertyGroup>
		<MokatermPluginId>moka.passwords</MokatermPluginId>
		<MokatermPluginName>Password Generator</MokatermPluginName>
		<MokatermPluginPublisher>Moka</MokatermPluginPublisher>
		<MokatermPluginDescription>Generate passwords, passphrases and PINs, see how strong their settings are, and copy them so the clipboard clears.</MokatermPluginDescription>
		<MokatermPluginHosts>desktop;web</MokatermPluginHosts>
		<MokatermPluginPackOnBuild>true</MokatermPluginPackOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Mokaterm.UI.Common" />
		<PackageReference Include="Mokaterm.Plugin.Sdk" PrivateAssets="all" />
	</ItemGroup>

	<!-- The EFF large word list (CC BY 3.0 US), words only; wwwroot/NOTICE.txt credits it inside the package. -->
	<ItemGroup>
		<EmbeddedResource Include="Generation\eff-large-words.txt" LogicalName="Moka.Passwords.eff-large-words.txt" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Moka.Passwords.Tests" />
	</ItemGroup>

</Project>
