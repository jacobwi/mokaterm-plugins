@inherits SettingsSectionBase<PasswordSettings>

@{
	PasswordSettings settings = Settings.Clamped();
}

@* What the Password Generator starts with, built from the same fields as Mokaterm's own settings pages and found by
   the settings search through each row's label and description. Nothing generated is ever kept. *@
<SettingsPage Title="Password Generator" OnReset="ResetAsync">
	<SettingsSection Title="Tool">
		<SettingsRow Label="Opens on" Description="What the tool shows first.">
			<EnumSegmentedControl TEnum="GenerationMode"
								  Value="settings.Mode"
								  ValueChanged="value => SaveAsync(s => s with { Mode = value })"
								  Options="ModeOptions.All"
								  AriaLabel="What the tool opens on" />
		</SettingsRow>
		<SettingsRow Label="How many" Description="How many values each run makes.">
			<NumberSetting TValue="int"
						   Value="settings.Count"
						   ValueChanged="value => SaveAsync(s => s with { Count = value })"
						   Min="PasswordSettings.MinCount"
						   Max="PasswordSettings.MaxCount"
						   AriaLabel="How many values each run makes" />
		</SettingsRow>
		<SettingsRow Label="Start hidden" Description="Hide the values until shown, for a screen someone else can see. Copying works either way.">
			<MokaSwitch Value="settings.StartHidden" ValueChanged="value => SaveAsync(s => s with { StartHidden = value })" aria-label="Start hidden" />
		</SettingsRow>
	</SettingsSection>

	<SettingsSection Title="Passwords">
		<SettingsRow Label="Length">
			<NumberSetting TValue="int"
						   Value="settings.Length"
						   ValueChanged="value => SaveAsync(s => s with { Length = value })"
						   Min="PasswordSettings.MinLength"
						   Max="PasswordSettings.MaxLength"
						   Suffix="characters"
						   AriaLabel="Password length" />
		</SettingsRow>
		<SettingsRow Label="Characters" Description="The kinds a password is drawn from. At least one stays chosen.">
			<KindChoices Options="settings.ToPasswordOptions()" OptionsChanged="SaveKindsAsync" />
		</SettingsRow>
		<SettingsRow Label="Symbols" Description="The symbols passwords draw from, and passphrases when they add one. ASCII symbols only." Stacked>
			<TextSetting Value="@settings.SymbolSet"
						 ValueChanged="value => SaveAsync(s => s with { SymbolSet = value })"
						 Validate="CharacterSets.SymbolSetProblem"
						 EmptyError="Type at least one symbol."
						 AriaLabel="Symbol set" />
		</SettingsRow>
		<SettingsRow Label="Leave out look-alikes" Description="No I, l, 1, |, O, 0 or o, which many fonts make hard to tell apart.">
			<MokaSwitch Value="settings.AvoidLookAlikes" ValueChanged="value => SaveAsync(s => s with { AvoidLookAlikes = value })" aria-label="Leave out look-alikes" />
		</SettingsRow>
		<SettingsRow Label="At least one of each" Description="Every chosen kind appears in every password.">
			<MokaSwitch Value="settings.RequireEachKind" ValueChanged="value => SaveAsync(s => s with { RequireEachKind = value })" aria-label="At least one of each kind" />
		</SettingsRow>
	</SettingsSection>

	<SettingsSection Title="Passphrases">
		<SettingsRow Label="Words">
			<NumberSetting TValue="int"
						   Value="settings.Words"
						   ValueChanged="value => SaveAsync(s => s with { Words = value })"
						   Min="PasswordSettings.MinWords"
						   Max="PasswordSettings.MaxWords"
						   Suffix="words"
						   AriaLabel="Words in a passphrase" />
		</SettingsRow>
		<SettingsRow Label="Separator" Description="What goes between the words.">
			<EnumSegmentedControl TEnum="PassphraseSeparator"
								  Value="settings.Separator"
								  ValueChanged="value => SaveAsync(s => s with { Separator = value })"
								  Options="SeparatorOptions.All"
								  AriaLabel="Separator" />
		</SettingsRow>
		@if (settings.Separator == PassphraseSeparator.Custom)
		{
			@* Only drawn while Custom is picked, so the search would scroll to nothing; it finds the Separator row above. *@
			<SettingsRow Label="Custom separator" Description="Up to four symbols or digits." Searchable="false">
				<TextSetting Value="@settings.CustomSeparator"
							 ValueChanged="value => SaveAsync(s => s with { CustomSeparator = value })"
							 Validate="PassphraseOptions.CustomSeparatorProblem"
							 EmptyError="Type a separator."
							 Width="120px"
							 AriaLabel="Custom separator" />
			</SettingsRow>
		}
		<SettingsRow Label="Capitalize words" Description="Each word starts with a capital letter.">
			<MokaSwitch Value="settings.Capitalize" ValueChanged="value => SaveAsync(s => s with { Capitalize = value })" aria-label="Capitalize words" />
		</SettingsRow>
		<SettingsRow Label="Add a digit" Description="A random digit after a random word.">
			<MokaSwitch Value="settings.AddDigit" ValueChanged="value => SaveAsync(s => s with { AddDigit = value })" aria-label="Add a digit" />
		</SettingsRow>
		<SettingsRow Label="Add a symbol" Description="A random symbol from the set above, after a random word.">
			<MokaSwitch Value="settings.AddSymbol" ValueChanged="value => SaveAsync(s => s with { AddSymbol = value })" aria-label="Add a symbol" />
		</SettingsRow>
	</SettingsSection>

	<SettingsSection Title="PINs">
		<SettingsRow Label="Digits">
			<NumberSetting TValue="int"
						   Value="settings.PinDigits"
						   ValueChanged="value => SaveAsync(s => s with { PinDigits = value })"
						   Min="PasswordSettings.MinPinDigits"
						   Max="PasswordSettings.MaxPinDigits"
						   Suffix="digits"
						   AriaLabel="Digits in a PIN" />
		</SettingsRow>
	</SettingsSection>

	<SettingsSection Title="Credits">
		<SettingsRow Label="Word list" Description="@WordList.Credit" Searchable="false" />
	</SettingsSection>
</SettingsPage>
