@inherits AppToolBase

@* The Password Generator: a tab per kind of value, its options beside or above the strength and the values. Values
   follow the options: any change makes a fresh set. *@
<div class="mp-tool">
	<ViewTabs Tabs="ModeOptions.Tabs" Active="@_mode.ToString()" ActiveChanged="OnModeChanged" Label="What to generate" />

	<ToolPageFrame Title="@ModeOptions.Name(_mode)"
				   Summary="@Summary"
				   Loaded="true"
				   PrimaryText="Regenerate"
				   PrimaryIcon="MokaIcons.Action.Refresh"
				   PrimaryDisabled="@(_problem is not null)"
				   PrimaryTitle="@_problem"
				   OnPrimary="Regenerate">
		<div class="mp-layout">
			<div class="mp-options">
				@switch (_mode)
				{
					case GenerationMode.Password:
						<PasswordOptionsPanel Options="_password" OptionsChanged="OnPasswordChanged" />
						break;
					case GenerationMode.Passphrase:
						<PassphraseOptionsPanel Options="_passphrase" OptionsChanged="OnPassphraseChanged" />
						break;
					default:
						<div class="mp-group">
							<span class="mp-label">Digits</span>
							<NumberSetting TValue="int"
										   Value="_pinDigits"
										   ValueChanged="OnPinDigitsChanged"
										   Min="PasswordSettings.MinPinDigits"
										   Max="PasswordSettings.MaxPinDigits"
										   Suffix="@($"digits, {PasswordSettings.MinPinDigits} to {PasswordSettings.MaxPinDigits}")"
										   AriaLabel="Digits in a PIN" />
						</div>
						break;
				}
			</div>

			<div class="mp-output">
				@if (_problem is { } problem)
				{
					<MokaAlert Severity="MokaToastSeverity.Warning" Dense>@problem</MokaAlert>
				}
				else if (_strength is { } strength)
				{
					<StrengthMeter Report="strength" Notes="Notes" />
				}

				<section class="mp-results" aria-label="Generated values">
					<div class="mp-results-head">
						<span class="mp-label">How many</span>
						<NumberSetting TValue="int"
									   Value="_count"
									   ValueChanged="OnCountChanged"
									   Min="PasswordSettings.MinCount"
									   Max="PasswordSettings.MaxCount"
									   Width="64px"
									   AriaLabel="How many to generate" />
						<span class="mp-gap"></span>
						<MokaButton Variant="MokaVariant.Text"
									Color="MokaColor.Surface"
									Size="MokaSize.Xs"
									StartIcon="@(_hidden ? MokaIcons.Toggle.Eye : MokaIcons.Toggle.EyeOff)"
									aria-pressed="@(_hidden ? "false" : "true")"
									OnClick="ToggleHidden">
							@(_hidden ? "Show" : "Hide")
						</MokaButton>
					</div>

					@if (_values.Count > 0)
					{
						<ol class="mp-list">
							@for (int index = 0; index < _values.Count; index++)
							{
								int row = index;
								<li @key="row" class="mp-item">
									<span class="mp-item-index">@(row + 1)</span>
									<GeneratedValue Value="@_values[row]" Hidden="_hidden" />
									<MokaButton Variant="MokaVariant.Text"
												Size="MokaSize.Xs"
												StartIcon="@(row == _copied ? MokaIcons.Status.Check : MokaIcons.Content.Copy)"
												title="Copy, then clear the clipboard"
												aria-label="@($"Copy {ModeOptions.InSentence(_mode)} {row + 1}")"
												OnClick="() => CopyAsync(row)" />
								</li>
							}
						</ol>
					}
				</section>

				@if (_mode == GenerationMode.Passphrase)
				{
					<span class="mp-credit">@WordList.Credit</span>
				}
			</div>
		</div>
	</ToolPageFrame>
</div>
