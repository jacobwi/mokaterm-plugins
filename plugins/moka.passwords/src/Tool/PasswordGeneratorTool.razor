@inherits AppToolBase

@* The Password Generator: a tab per kind of value, its options beside or above the strength and the values. Values
   follow the options: any change makes a fresh set. *@
<div class="mp-tool">
	<ViewTabs Tabs="ModeOptions.Tabs" Active="@_mode.ToString()" ActiveChanged="OnModeChanged" Label="What to generate" />

	<MokaPageHeader Class="mp-head" Title="@ModeOptions.Name(_mode)" Said="@Summary">
		<Actions>
			<MokaButton Variant="MokaVariant.Text"
						Color="MokaColor.Surface"
						Size="MokaSize.Xs"
						StartIcon="@(_hidden ? MokaIcons.Toggle.Eye : MokaIcons.Toggle.EyeOff)"
						aria-pressed="@(_hidden ? "false" : "true")"
						OnClick="ToggleHidden">
				@(_hidden ? "Show" : "Hide")
			</MokaButton>
			<Hint Text="@_problem">
				<MokaButton Variant="MokaVariant.Outlined"
							Size="MokaSize.Xs"
							StartIcon="MokaIcons.Action.Refresh"
							Disabled="@(_problem is not null)"
							OnClick="Regenerate">
					Regenerate
				</MokaButton>
			</Hint>
		</Actions>
	</MokaPageHeader>

	<div class="mp-layout">
		<MokaFlexbox Class="mp-column" Gap="MokaSpacingScale.Md">
			@switch (_mode)
			{
				case GenerationMode.Password:
					<PasswordOptionsPanel Options="_password" OptionsChanged="OnPasswordChanged" />
					break;
				case GenerationMode.Passphrase:
					<PassphraseOptionsPanel Options="_passphrase" OptionsChanged="OnPassphraseChanged" />
					break;
				default:
					<MokaCard Inner Title="Digits">
						<NumberSetting TValue="int"
									   Value="_pinDigits"
									   ValueChanged="OnPinDigitsChanged"
									   Min="PasswordSettings.MinPinDigits"
									   Max="PasswordSettings.MaxPinDigits"
									   Suffix="@($"digits, {PasswordSettings.MinPinDigits} to {PasswordSettings.MaxPinDigits}")"
									   AriaLabel="Digits in a PIN" />
					</MokaCard>
					break;
			}
		</MokaFlexbox>

		<MokaFlexbox Class="mp-column" Gap="MokaSpacingScale.Md">
			@if (_problem is { } problem)
			{
				<MokaAlert Severity="MokaToastSeverity.Warning" Dense>@problem</MokaAlert>
			}
			else if (_strength is { } strength)
			{
				<StrengthMeter Report="strength" Notes="Notes" />
			}

			<MokaCard Inner Title="@ValuesTitle" role="region" aria-label="Generated values">
				<HeaderActions>
					<MokaFlexbox Direction="MokaDirection.Row" Align="MokaAlign.Center" Gap="MokaSpacingScale.Sm">
						<MokaLabel Micro>How many</MokaLabel>
						<NumberSetting TValue="int"
									   Value="_count"
									   ValueChanged="OnCountChanged"
									   Min="PasswordSettings.MinCount"
									   Max="PasswordSettings.MaxCount"
									   Width="64px"
									   AriaLabel="How many to generate" />
					</MokaFlexbox>
				</HeaderActions>
				<ChildContent>
					<MokaTable TItem="GeneratedRow"
							   Items="Rows"
							   ItemKey="row => row.Number"
							   Label="@ValuesTitle"
							   ShowToolbar="false"
							   ShowPagination="false"
							   Dense="true"
							   Bleed="true"
							   EmptyTitle="Nothing to make"
							   EmptyText="Change the options above until they can make a value."
							   ActionsColumnTitle=""
							   ActionsColumnWidth="44px">
						<ChildContent>
							<MokaColumn TItem="GeneratedRow" Title="#" Field="row => row.Number" Sortable="false" Mono Width="44px" Align="MokaTextAlign.Right" CellClass="mp-number" />
							<MokaColumn TItem="GeneratedRow" Title="@ModeOptions.Name(_mode)" Sortable="false">
								<CellTemplate Context="row">
									<GeneratedValue Value="@row.Value" Hidden="_hidden" />
								</CellTemplate>
							</MokaColumn>
						</ChildContent>
						<RowActions Context="row">
							<IconButton Icon="@(row.Number - 1 == _copied ? MokaIcons.Status.Check : MokaIcons.Content.Copy)"
										Label="@($"Copy {ModeOptions.InSentence(_mode)} {row.Number}")"
										Color="MokaColor.Primary"
										Size="MokaSize.Xs"
										Position="MokaTooltipPosition.BottomEnd"
										OnClick="() => CopyAsync(row.Number - 1)" />
						</RowActions>
					</MokaTable>
				</ChildContent>
			</MokaCard>

			@if (_mode == GenerationMode.Passphrase)
			{
				<MokaCaption>@_passphrase.WordList.Credit</MokaCaption>
			}
		</MokaFlexbox>
	</div>
</div>
