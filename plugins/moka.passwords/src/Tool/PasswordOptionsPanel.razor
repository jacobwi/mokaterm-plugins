@* The password options: length, kinds, the symbol set and the two rules. Every change goes straight back up. *@
<div class="mp-group">
	<span class="mp-label">Length</span>
	<NumberSetting TValue="int"
				   Value="Options.Length"
				   ValueChanged="value => ChangeAsync(Options with { Length = value })"
				   Min="PasswordSettings.MinLength"
				   Max="PasswordSettings.MaxLength"
				   Suffix="@($"characters, {PasswordSettings.MinLength} to {PasswordSettings.MaxLength}")"
				   AriaLabel="Password length" />
</div>

<div class="mp-group">
	<span class="mp-label">Characters</span>
	<KindChoices Options="Options" OptionsChanged="ChangeAsync" />
	@if (Options.Symbols)
	{
		<div class="mp-symbols">
			<TextSetting Value="@Options.SymbolSet"
						 ValueChanged="value => ChangeAsync(Options with { SymbolSet = value })"
						 Validate="CharacterSets.SymbolSetProblem"
						 EmptyError="Type at least one symbol."
						 AriaLabel="Symbols to draw from" />
		</div>
	}
</div>

<div class="mp-group">
	<span class="mp-label">Rules</span>
	<MokaCheckbox Label="Leave out look-alikes: I l 1 | O 0 o"
				  Value="Options.AvoidLookAlikes"
				  ValueChanged="value => ChangeAsync(Options with { AvoidLookAlikes = value })" />
	<MokaCheckbox Label="At least one of each chosen kind"
				  Value="Options.RequireEachKind"
				  ValueChanged="value => ChangeAsync(Options with { RequireEachKind = value })"
				  Disabled="@(Options.KindCount < 2)" />
</div>

@code {
	[Parameter, EditorRequired]
	public PasswordOptions Options { get; set; } = new();

	[Parameter]
	public EventCallback<PasswordOptions> OptionsChanged { get; set; }

	private Task ChangeAsync(PasswordOptions options) => OptionsChanged.InvokeAsync(options);
}
