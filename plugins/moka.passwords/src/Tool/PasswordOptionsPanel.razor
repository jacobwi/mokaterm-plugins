@using System.Globalization
@using Moka.Red.Data.Chart

@* The password options: length, kinds, the symbol set and the two rules. Every change goes straight back up. *@
<MokaCard Inner Title="Length">
	<NumberSetting TValue="int"
				   Value="Options.Length"
				   ValueChanged="value => ChangeAsync(Options with { Length = value })"
				   Min="PasswordSettings.MinLength"
				   Max="PasswordSettings.MaxLength"
				   Suffix="@($"characters, {PasswordSettings.MinLength} to {PasswordSettings.MaxLength}")"
				   AriaLabel="Password length" />
</MokaCard>

<MokaCard Inner Title="Characters">
	<MokaFlexbox Gap="MokaSpacingScale.Md">
		<KindChoices Options="Options" OptionsChanged="ChangeAsync" />
		@if (Options.Symbols)
		{
			<div class="mp-symbols">
				<TextSetting Value="@Options.SymbolSet"
							 ValueChanged="value => ChangeAsync(Options with { SymbolSet = value })"
							 Validate="CharacterSets.SymbolSetProblem"
							 EmptyError="Type at least one symbol."
							 Label="Symbols to draw from"
							 AriaLabel="Symbols to draw from" />
			</div>
		}
		<div class="mp-symbols">
			<TextSetting Value="@Options.Excluded"
						 ValueChanged="value => ChangeAsync(Options with { Excluded = value })"
						 Validate="CharacterSets.ExcludedProblem"
						 AllowEmpty="true"
						 Label="Leave out"
						 Placeholder="Characters that never appear"
						 AriaLabel="Characters to leave out" />
		</div>
	</MokaFlexbox>
</MokaCard>

<MokaCard Inner Title="Rules">
	<MokaFlexbox Gap="MokaSpacingScale.Sm">
		<MokaCheckbox Label="Leave out look-alikes: I l 1 | O 0 o"
					  Value="Options.AvoidLookAlikes"
					  ValueChanged="value => ChangeAsync(Options with { AvoidLookAlikes = value })" />
		<MokaCheckbox Label="At least one of each chosen kind"
					  Value="Options.RequireEachKind"
					  ValueChanged="value => ChangeAsync(Options with { RequireEachKind = value })"
					  Disabled="@(Options.KindCount < 2)" />
	</MokaFlexbox>
</MokaCard>

@if (PasswordAlphabet.ProblemWith(Options) is null)
{
	PasswordAlphabet alphabet = PasswordAlphabet.For(Options);
	<MokaCard Inner Title="Drawn from">
		<MokaDonutChart Segments="@Shares(alphabet)" Size="MokaSize.Md" Thickness="22" Label="@($"{alphabet.Size} characters on offer, by kind")">
			<MokaStat Value="@alphabet.Size.ToString(CultureInfo.CurrentCulture)" Label="characters" Align="MokaTextAlign.Center" Size="MokaSize.Sm" />
		</MokaDonutChart>
	</MokaCard>
}

@code {
	[Parameter, EditorRequired]
	public PasswordOptions Options { get; set; } = new();

	[Parameter]
	public EventCallback<PasswordOptions> OptionsChanged { get; set; }

	private Task ChangeAsync(PasswordOptions options) => OptionsChanged.InvokeAsync(options);

	private static IReadOnlyList<MokaDonutSegment> Shares(PasswordAlphabet alphabet) =>
		[.. alphabet.Classes.Select(item => new MokaDonutSegment
		{
			Name = $"{KindChoices.NameOf(item.Kind)} {item.Characters.Length}",
			Value = item.Characters.Length,
			Color = item.Kind switch
			{
				CharacterKind.Lowercase => MokaColor.Secondary,
				CharacterKind.Uppercase => MokaColor.Surface,
				CharacterKind.Digit => MokaColor.Info,
				_ => MokaColor.Primary,
			},
		})];
}
