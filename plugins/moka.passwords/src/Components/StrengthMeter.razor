@using Moka.Passwords.Strength

@* The strength of the generator's settings: a ring filled to 128 bits with the label in it, the bits, and how long
   trying every value would take. *@
<MokaCard Inner Title="Strength" role="region" aria-label="Strength">
	<MokaFlexbox Direction="MokaDirection.Row" Wrap Align="MokaAlign.Center" Gap="MokaSpacingScale.Lg">
		<MokaGauge Value="FlooredBits"
				   Max="StrengthScale.FullBarBits"
				   Format="0.0"
				   ShowValue="false"
				   Word="@Report.Label"
				   Color="LevelColor"
				   Size="MokaSize.Sm"
				   Label="Strength in bits" />
		<MokaGrid Class="mp-strength-figures" MinColumn="150px" Gap="MokaSpacingScale.Sm">
			<MokaStat Tile Value="@Report.BitsText" Suffix="bits" Label="Entropy" Color="LevelColor" />
			<MokaStat Tile Value="@Report.TimeToTryAll" Label="To try every one" HelpText="@($"at {StrengthScale.RateText}")" />
		</MokaGrid>
	</MokaFlexbox>
	@foreach (string note in Notes)
	{
		<MokaCallout Type="MokaCalloutType.Note" Title="Worth knowing">@note</MokaCallout>
	}
	<MokaCaption>This rates the generator's settings, so it holds for every value they make. It says nothing about a password someone typed.</MokaCaption>
</MokaCard>

@code {
	[Parameter, EditorRequired]
	public StrengthReport Report { get; set; } = StrengthReport.For(0);

	/// <summary>What else bears on the figure, such as an upper bound or a PIN's lock-out.</summary>
	[Parameter]
	public IReadOnlyList<string> Notes { get; set; } = [];

	// Floored like BitsText, so the ring's spoken value never reaches a threshold its label has not.
	private double FlooredBits => Math.Floor(Report.Bits * 10) / 10;

	private MokaColor LevelColor => Report.Level switch
	{
		StrengthLevel.VeryStrong or StrengthLevel.Strong => MokaColor.Success,
		StrengthLevel.Fair => MokaColor.Warning,
		_ => MokaColor.Error,
	};
}
