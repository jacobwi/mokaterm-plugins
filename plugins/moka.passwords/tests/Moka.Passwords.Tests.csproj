<Project Sdk="Microsoft.NET.Sdk">

	<!--
		The generators, the strength maths, the embedded word list, the settings and what the module registers. Statistical
		checks use fixed bounds many standard deviations wide, so they cannot fail by chance. xunit v3 on
		Microsoft.Testing.Platform, like Mokaterm's own tests.
	-->
	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<RootNamespace>Moka.Passwords.Tests</RootNamespace>
	</PropertyGroup>

	<!--
		CA1707: Method_Scenario_Expectation names.
		CA2000: tests create and drop disposables freely.
	-->
	<PropertyGroup>
		<NoWarn>$(NoWarn);CA1707;CA2000</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="xunit.runner.visualstudio" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />

		<!-- The plugin takes this from its host and does not copy it; a test project is its own host. -->
		<PackageReference Include="Mokaterm.UI.Common" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\src\Moka.Passwords.csproj" />
	</ItemGroup>

</Project>
