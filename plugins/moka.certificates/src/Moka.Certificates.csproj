<Project Sdk="Microsoft.NET.Sdk.Razor">

	<!--
		Certificates and keys for Mokaterm: an app tool (inspect, generate, convert, sign, encrypt, check a server), a
		System view page that finds the certificates a server uses, and a settings page. The certificate logic lives in
		plain classes under Crypto, Tls and ServerFiles, which every view goes through. Every build writes
		bin/<configuration>/net10.0/moka.certificates-<version>.mokaplugin.
	-->
	<PropertyGroup>
		<AssemblyName>Moka.Certificates</AssemblyName>
		<RootNamespace>Moka.Certificates</RootNamespace>
		<Version>1.0.0</Version>
	</PropertyGroup>

	<PropertyGroup>
		<MokatermPluginId>moka.certificates</MokatermPluginId>
		<MokatermPluginName>Certificates</MokatermPluginName>
		<MokatermPluginPublisher>Moka</MokatermPluginPublisher>
		<MokatermPluginDescription>Inspect, generate, convert, sign and encrypt with certificates and keys, check a server's TLS chain, and find the certificates a server uses.</MokatermPluginDescription>
		<MokatermPluginHosts>desktop;web</MokatermPluginHosts>
		<MokatermPluginPackOnBuild>true</MokatermPluginPackOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Mokaterm.UI.Common" />
		<PackageReference Include="Mokaterm.Plugin.Sdk" PrivateAssets="all" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Moka.Certificates.Tests" />
	</ItemGroup>

</Project>
