@inherits CertificateViewBase

<ToolPageFrame Title="Encrypt and decrypt"
			   Summary="@ModeSummary"
			   Loaded="true"
			   PrimaryText="@(Decrypting ? "Decrypt" : "Encrypt")"
			   PrimaryIcon="CertificateIcons.Encrypt"
			   PrimaryDisabled="_busy"
			   OnPrimary="RunAsync">
	<MokaFlexbox Gap="MokaSpacingScale.Md">
		<MokaCard Inner Outlined Title="What to do" Subtitle="@ModeHelp">
			<EnumSegmentedControl TEnum="EncryptMode" Value="_mode" ValueChanged="OnModeChanged" Options="Modes" AriaLabel="Encrypt or decrypt" Disabled="_busy" />
		</MokaCard>

		<MokaGrid MinColumn="22rem" Gap="MokaSpacingScale.Md">
			@if (Decrypting)
			{
				<InputBox Label="@(_mode == EncryptMode.OaepDecrypt ? "Ciphertext" : "Encrypted message")"
						  Value="_data"
						  ValueChanged="@(value => { _data = value; _result = null; })"
						  Placeholder="@(_mode == EncryptMode.OaepDecrypt ? "Paste the ciphertext as base64 or hex, or open its file" : "Paste a CMS PEM block or base64, or open a .p7m file")"
						  Rows="4"
						  FileWhat="the encrypted data"
						  KeepFilesAsBytes="@(_mode == EncryptMode.OaepDecrypt)" />
				<InputBox Label="@(_mode == EncryptMode.OaepDecrypt ? "Private key (or a PFX)" : "Your certificate and private key, or a PFX")"
						  Value="_key"
						  ValueChanged="@(value => { _key = value; _result = null; })"
						  Placeholder="Paste as PEM, or open a key or PFX file"
						  Rows="4"
						  FileWhat="a key or PFX">
					<MokaPasswordField Label="Password" Optional Value="@_password" ValueChanged="@(value => _password = value ?? "")" Placeholder="The key's or PFX's password" Size="MokaSize.Sm" autocomplete="off" />
				</InputBox>
			}
			else
			{
				<InputBox Label="Data"
						  Hint="@(_mode == EncryptMode.OaepEncrypt ? "A few bytes, such as a password or a key: RSA-OAEP takes no more than the key allows." : null)"
						  Value="_data"
						  ValueChanged="@(value => { _data = value; _result = null; })"
						  Placeholder="Type or paste the text, or open the file"
						  Rows="4"
						  FileWhat="the data"
						  KeepFilesAsBytes />
				<InputBox Label="@(_mode == EncryptMode.OaepEncrypt ? "Recipient's certificate or public key" : "Recipients' certificates")"
						  Hint="@(_mode == EncryptMode.OaepEncrypt ? OaepLimit : "Each one can open the message.")"
						  Value="_key"
						  ValueChanged="@(value => { _key = value; _result = null; })"
						  Placeholder="@(_mode == EncryptMode.OaepEncrypt ? "Paste an RSA certificate or public key" : "Paste one or more RSA certificates as PEM")"
						  Rows="4" />
			}
		</MokaGrid>

		@if (_mode != EncryptMode.CmsDecrypt)
		{
			<MokaCard Inner Outlined Title="Options" Subtitle="@(_mode == EncryptMode.CmsEncrypt ? "The content is encrypted with AES-256-CBC and its key wrapped for each recipient with RSA-OAEP (SHA-256). Recipients need RSA certificates." : null)">
				<MokaGrid MinColumn="13rem" Gap="MokaSpacingScale.Md" AlignItems="MokaAlign.Start">
					@if (_mode is EncryptMode.OaepEncrypt or EncryptMode.OaepDecrypt)
					{
						<MokaFieldWrapper Label="OAEP hash" Size="MokaSize.Sm" CustomControl>
							<EnumSegmentedControl TEnum="OaepHash" Value="_oaepHash" ValueChanged="@(value => _oaepHash = value)" Options="OaepHashes" AriaLabel="OAEP hash" Disabled="_busy" />
						</MokaFieldWrapper>
					}
					@if (_mode == EncryptMode.OaepEncrypt)
					{
						<MokaFieldWrapper Label="Write the ciphertext as" Size="MokaSize.Sm" CustomControl>
							<EnumSegmentedControl TEnum="BinaryEncoding" Value="_encoding" ValueChanged="@(value => _encoding = value)" Options="Encodings" AriaLabel="Output encoding" Disabled="_busy" />
						</MokaFieldWrapper>
					}
					@if (_mode == EncryptMode.CmsEncrypt)
					{
						<MokaFieldWrapper Label="Key transport" Size="MokaSize.Sm" CustomControl>
							<MokaCheckbox Label="RSA PKCS#1 v1.5, for old mail clients" Value="_pkcs1" ValueChanged="@(value => _pkcs1 = value)" />
						</MokaFieldWrapper>
					}
				</MokaGrid>
			</MokaCard>
		}

		@if (_error is { } error)
		{
			<MokaAlert Severity="MokaToastSeverity.Error" Dense>@error</MokaAlert>
		}

		@if (_result is { } result)
		{
			@if (result.Summary is { } summary)
			{
				<MokaAlert Severity="MokaToastSeverity.Success" Title="@(Decrypting ? "Decrypted" : "Encrypted")">@summary</MokaAlert>
			}

			@if (result.Text is { } text)
			{
				<OutputCard Title="@result.TextTitle" Text="@text" FileName="@result.TextFileName" Bytes="@result.Bytes" BytesFileName="@result.BytesFileName" BytesLabel="@result.BytesLabel" CopyName="@result.TextTitle" Secret="Decrypting" />
			}
			else if (result.Bytes is { } bytes)
			{
				<OutputCard Title="@result.TextTitle" Detail="@SignSection.BytesNote(bytes)" Bytes="@bytes" BytesFileName="@result.BytesFileName" BytesLabel="Save" />
			}
		}
	</MokaFlexbox>
</ToolPageFrame>
