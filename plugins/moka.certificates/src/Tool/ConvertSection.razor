@inherits CertificateViewBase

<ToolPageFrame Title="Convert"
			   Summary="@KindLabel(_kind)"
			   Loaded="true"
			   PrimaryText="Convert"
			   PrimaryIcon="CertificateIcons.Convert"
			   PrimaryDisabled="@(_busy || _input.IsEmpty)"
			   OnPrimary="ConvertAsync">
	<MokaFlexbox Gap="MokaSpacingScale.Md">
		<MokaCard Inner Outlined Title="What to convert" Subtitle="@KindHelp">
			<MokaSelect TValue="ConvertKind"
						Label="Conversion"
						Items="KindList"
						Value="_kind"
						ValueChanged="OnKindChanged"
						ValueSelector="KindLabel"
						Size="MokaSize.Sm" />
		</MokaCard>

		<InputBox Label="@InputLabel"
				  Value="_input"
				  ValueChanged="OnInputChanged"
				  Placeholder="@InputPlaceholder"
				  Rows="7"
				  FileWhat="a certificate, key or PFX">
			@if (TakesPassword)
			{
				<MokaPasswordField Label="Password"
								   Optional="@(_kind is not (ConvertKind.PfxToPem or ConvertKind.DecryptKey))"
								   Value="@_password"
								   ValueChanged="@(value => _password = value ?? "")"
								   Placeholder="@PasswordPlaceholder"
								   Size="MokaSize.Sm"
								   autocomplete="off" />
			}
		</InputBox>

		@switch (_kind)
		{
			case ConvertKind.PfxToPem:
				<MokaCard Inner Outlined Title="Key in the PEM">
					<MokaGrid MinColumn="15rem" Gap="MokaSpacingScale.Md" AlignItems="MokaAlign.Start">
						<MokaFieldWrapper Label="Format" Size="MokaSize.Sm" CustomControl>
							<EnumSegmentedControl TEnum="PrivateKeyFormat" Value="_format" ValueChanged="@(value => _format = value)" Options="Formats" AriaLabel="Key format" />
						</MokaFieldWrapper>
						<MokaPasswordField Label="Encrypt it with" Optional Value="@_newPassword" ValueChanged="@(value => _newPassword = value ?? "")" Placeholder="A password for the key" Size="MokaSize.Sm" autocomplete="new-password" />
					</MokaGrid>
				</MokaCard>
				break;
			case ConvertKind.PemToPfx:
				<MokaCard Inner Outlined Title="The PFX" Subtitle="AES-256 opens on Windows 10 1709 and Server 2019 and later, and everywhere else. Pick 3DES only for older Windows or old Java.">
					<MokaGrid MinColumn="13rem" Gap="MokaSpacingScale.Md" AlignItems="MokaAlign.Start">
						<MokaPasswordField Label="PFX password" Value="@_newPassword" ValueChanged="@(value => _newPassword = value ?? "")" Size="MokaSize.Sm" autocomplete="new-password" />
						<MokaTextField Label="Friendly name" Optional Value="@_friendlyName" ValueChanged="@(value => _friendlyName = value ?? "")" Size="MokaSize.Sm" autocomplete="off" />
						<MokaFieldWrapper Label="Encryption" Size="MokaSize.Sm" CustomControl>
							<EnumSegmentedControl TEnum="PfxEncryption" Value="_pfxEncryption" ValueChanged="@(value => _pfxEncryption = value)" Options="PfxChoices" AriaLabel="PFX encryption" />
						</MokaFieldWrapper>
					</MokaGrid>
				</MokaCard>
				break;
			case ConvertKind.KeyFormat:
				<MokaCard Inner Outlined Title="Write the key as">
					<EnumSegmentedControl TEnum="PrivateKeyFormat" Value="_format" ValueChanged="@(value => _format = value)" Options="Formats" AriaLabel="Key format" />
				</MokaCard>
				break;
			case ConvertKind.EncryptKey:
				<MokaCard Inner Outlined Title="New password" Subtitle="@EncryptionNote">
					<MokaGrid MinColumn="13rem" Gap="MokaSpacingScale.Md" AlignItems="MokaAlign.Start">
						<MokaPasswordField Label="Password" Value="@_newPassword" ValueChanged="@(value => _newPassword = value ?? "")" Size="MokaSize.Sm" autocomplete="new-password" />
						<MokaPasswordField Label="Again" Value="@_newPasswordAgain" ValueChanged="@(value => _newPasswordAgain = value ?? "")" ErrorText="@Mismatch" Size="MokaSize.Sm" autocomplete="new-password" />
					</MokaGrid>
				</MokaCard>
				break;
		}

		@if (_error is { } error)
		{
			<MokaAlert Severity="MokaToastSeverity.Error" Dense>@error</MokaAlert>
		}

		@foreach (string note in _notes)
		{
			<MokaCallout Type="MokaCalloutType.Note">@note</MokaCallout>
		}

		@foreach (ConvertedOutput output in _outputs)
		{
			<OutputCard Title="@output.Title"
						Detail="@output.Detail"
						Text="@output.Text"
						FileName="@output.FileName"
						Bytes="@output.Bytes"
						BytesFileName="@output.BytesFileName"
						BytesLabel="@(output.Text is null ? "Save" : "Save DER")"
						Secret="output.Secret"
						CopyName="@output.Title">
				<Actions>
					@if (!output.Secret && output.Text is { } text && text.Contains("-----BEGIN", StringComparison.Ordinal))
					{
						<MokaButton Variant="MokaVariant.Text" Color="MokaColor.Surface" Size="MokaSize.Xs" StartIcon="CertificateIcons.Inspect" OnClick="@(() => OnInspect.InvokeAsync(text))">Inspect</MokaButton>
					}
				</Actions>
			</OutputCard>
		}
	</MokaFlexbox>
</ToolPageFrame>
