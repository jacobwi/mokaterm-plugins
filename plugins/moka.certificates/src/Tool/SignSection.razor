@inherits CertificateViewBase

<ToolPageFrame Title="Sign and verify"
			   Summary="@ModeSummary"
			   Loaded="true"
			   PrimaryText="@PrimaryText"
			   PrimaryIcon="CertificateIcons.Sign"
			   PrimaryDisabled="_busy"
			   OnPrimary="RunAsync">
	<MokaFlexbox Gap="MokaSpacingScale.Md">
		<MokaCard Inner Outlined Title="What to do" Subtitle="@ModeHelp">
			<EnumSegmentedControl TEnum="SignMode" Value="_mode" ValueChanged="OnModeChanged" Options="Modes" AriaLabel="Sign or verify" Disabled="_busy" />
		</MokaCard>

		<MokaGrid MinColumn="22rem" Gap="MokaSpacingScale.Md">
			@if (_mode != SignMode.CmsVerify)
			{
				<InputBox Label="Data"
						  Hint="Text is signed as UTF-8, exactly as it is here."
						  Value="_data"
						  ValueChanged="@(value => { _data = value; _result = null; })"
						  Placeholder="Type or paste the text, or open the file"
						  Rows="4"
						  FileWhat="the data"
						  KeepFilesAsBytes />
			}

			@switch (_mode)
			{
				case SignMode.Sign:
				case SignMode.CmsSign:
					<InputBox Label="@(_mode == SignMode.Sign ? "Private key (or a PFX)" : "Signer")"
							  Hint="@(_mode == SignMode.Sign ? null : "Its certificate and private key, or a PFX.")"
							  Value="_key"
							  ValueChanged="@(value => { _key = value; _result = null; })"
							  Placeholder="@(_mode == SignMode.Sign ? "Paste a private key as PEM, or open a key or PFX file" : "Paste the certificate, its key and any chain as PEM, or open a PFX")"
							  Rows="4"
							  FileWhat="a key or PFX">
						<MokaPasswordField Label="Password" Optional Value="@_password" ValueChanged="@(value => _password = value ?? "")" Placeholder="The key's or PFX's password" Size="MokaSize.Sm" autocomplete="off" />
					</InputBox>
					break;
				case SignMode.Verify:
					<InputBox Label="Signature"
							  Value="_signature"
							  ValueChanged="@(value => { _signature = value; _result = null; })"
							  Placeholder="Paste the signature as base64 or hex, or open the signature file"
							  Rows="4"
							  FileWhat="a signature"
							  KeepFilesAsBytes />
					<InputBox Label="Certificate or public key"
							  Value="_key"
							  ValueChanged="@(value => { _key = value; _result = null; })"
							  Placeholder="Paste the signer's certificate or public key"
							  Rows="4" />
					break;
				case SignMode.CmsVerify:
					<InputBox Label="CMS signature"
							  Value="_signature"
							  ValueChanged="@(value => { _signature = value; _result = null; })"
							  Placeholder="Paste a CMS or PKCS7 PEM block or base64, or open a .p7s or .p7m file"
							  Rows="4"
							  FileWhat="a CMS signature" />
					<InputBox Label="Signed content (for a detached signature)"
							  Value="_data"
							  ValueChanged="@(value => { _data = value; _result = null; })"
							  Placeholder="Leave empty when the content is inside the signature"
							  Rows="4"
							  FileWhat="the signed content"
							  KeepFilesAsBytes />
					<InputBox Label="Expected signer (optional)"
							  Hint="It is also used when the signature does not include one."
							  Value="_key"
							  ValueChanged="@(value => { _key = value; _result = null; })"
							  Placeholder="Paste the certificate the signer must be"
							  Rows="4" />
					break;
			}
		</MokaGrid>

		@if (_mode != SignMode.CmsVerify)
		{
			<MokaCard Inner Outlined Title="Options" Subtitle="@(_mode is SignMode.Sign or SignMode.Verify ? "The RSA padding is ignored for ECDSA keys, whose signatures are DER like OpenSSL's; verifying also takes the raw form JOSE uses." : null)">
				<MokaGrid MinColumn="13rem" Gap="MokaSpacingScale.Md" AlignItems="MokaAlign.Start">
					<MokaFieldWrapper Label="Hash" Size="MokaSize.Sm" CustomControl>
						<EnumSegmentedControl TEnum="SignatureHash" Value="_hash" ValueChanged="@(value => _hash = value)" Options="Hashes" AriaLabel="Hash" Disabled="_busy" />
					</MokaFieldWrapper>
					@if (_mode is SignMode.Sign or SignMode.Verify)
					{
						<MokaFieldWrapper Label="RSA padding" Size="MokaSize.Sm" CustomControl>
							<EnumSegmentedControl TEnum="RsaSignatureScheme" Value="_scheme" ValueChanged="@(value => _scheme = value)" Options="Schemes" AriaLabel="RSA padding" Disabled="_busy" />
						</MokaFieldWrapper>
					}
					@if (_mode == SignMode.Sign)
					{
						<MokaFieldWrapper Label="Write the signature as" Size="MokaSize.Sm" CustomControl>
							<EnumSegmentedControl TEnum="BinaryEncoding" Value="_encoding" ValueChanged="@(value => _encoding = value)" Options="Encodings" AriaLabel="Signature encoding" Disabled="_busy" />
						</MokaFieldWrapper>
					}
					@if (_mode == SignMode.CmsSign)
					{
						<MokaFieldWrapper Label="Content" Size="MokaSize.Sm" CustomControl>
							<MokaCheckbox Label="Detached (the signature travels beside the content)" Value="_detached" ValueChanged="@(value => _detached = value)" />
						</MokaFieldWrapper>
					}
				</MokaGrid>
			</MokaCard>
		}

		@if (_error is { } error)
		{
			<MokaAlert Severity="MokaToastSeverity.Error" Dense>@error</MokaAlert>
		}

		@if (_result is { } result)
		{
			@if (result.Verdict is { } verdict)
			{
				<MokaAlert Severity="@(verdict ? MokaToastSeverity.Success : MokaToastSeverity.Error)" Title="@(verdict ? "Valid" : "Not valid")">@result.Summary</MokaAlert>
			}

			@if (result.Signers.Count > 0)
			{
				<MokaCard Inner Title="Signers" Subtitle="Each signature is checked against its signer's key. Trust in the signer is not judged.">
					<MokaTable TItem="CmsSignerResult"
							   Items="result.Signers"
							   Dense
							   ShowToolbar="false"
							   ShowPagination="false"
							   Label="Signers">
						<MokaColumn TItem="CmsSignerResult" Title="Signature" Field="@(signer => signer.Valid)" Width="150px">
							<CellTemplate>
								<MokaFlexbox Direction="MokaDirection.Row" Gap="MokaSpacingScale.Xxs" Wrap>
									<MokaTag Text="@(context.Valid ? "Signature ok" : "Bad signature")" Color="@(context.Valid ? MokaColor.Success : MokaColor.Error)" />
									@if (context.IsExpectedSigner is { } expected)
									{
										<MokaTag Text="@(expected ? "Expected signer" : "Someone else")" Color="@(expected ? MokaColor.Success : MokaColor.Warning)" />
									}
								</MokaFlexbox>
							</CellTemplate>
						</MokaColumn>
						<MokaColumn TItem="CmsSignerResult" Title="Signer" Field="@(signer => signer.Signer)">
							<CellTemplate>
								<CellLines Text="@context.Signer" Detail="@context.Problem" />
							</CellTemplate>
						</MokaColumn>
						<MokaColumn TItem="CmsSignerResult" Title="Digest" Field="@(signer => signer.DigestAlgorithm)" Width="120px" Mono />
						<MokaColumn TItem="CmsSignerResult" Title="Signed" Field="@(signer => signer.SigningTime)" Width="210px" Mono>
							<CellTemplate>@(context.SigningTime is { } time ? CertificateReport.Date(time) : "Not stated")</CellTemplate>
						</MokaColumn>
					</MokaTable>
				</MokaCard>
			}

			@if (result.Text is { } text)
			{
				<OutputCard Title="@result.TextTitle" Text="@text" FileName="@result.TextFileName" Bytes="@result.Bytes" BytesFileName="@result.BytesFileName" BytesLabel="@result.BytesLabel" CopyName="@result.TextTitle" />
			}
			else if (result.Bytes is { } bytes)
			{
				<OutputCard Title="@result.TextTitle" Detail="@BytesNote(bytes)" Bytes="@bytes" BytesFileName="@result.BytesFileName" BytesLabel="Save" />
			}
		}
	</MokaFlexbox>
</ToolPageFrame>
