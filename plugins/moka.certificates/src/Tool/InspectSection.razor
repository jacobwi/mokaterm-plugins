@inherits CertificateViewBase

<ToolPageFrame Title="Inspect" Summary="@Summary" Loaded="true" Loading="_reading">
	<MokaFlexbox Gap="MokaSpacingScale.Md">
		<InputBox Label="Certificates, keys or a request"
				  Value="_input"
				  ValueChanged="OnInputChangedAsync"
				  Placeholder="Paste PEM (-----BEGIN ...) or base64, or open a .pem, .crt, .cer, .der, .csr, .key, .pfx or .p12 file"
				  Hint="Everything is read on this machine; nothing is sent anywhere."
				  Rows="7">
			@if (_askPassword)
			{
				<div @onkeydown="OnPasswordKeyAsync">
					<MokaGrid ColumnsValue="minmax(0, 1fr) auto" Gap="MokaSpacingScale.Sm" AlignItems="MokaAlign.End">
						<MokaPasswordField Label="Password"
										   Value="@_password"
										   ValueChanged="OnPasswordChanged"
										   Placeholder="For the PFX or the encrypted key"
										   Size="MokaSize.Sm"
										   autocomplete="off" />
						<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm" StartIcon="MokatermIcons.Unlock" OnClick="ReadAsync">Open</MokaButton>
					</MokaGrid>
				</div>
			}
		</InputBox>

		<NoteList Notes="_inspection.Notes" />

		@if (_inspection.Items.Count > 0)
		{
			<MokaCard Inner Title="What it holds">
				<MokaTable TItem="InspectedItem"
						   Items="_inspection.Items"
						   ItemKey="@(item => item.Number)"
						   SelectedItems="SelectedSet"
						   OnRowClick="Select"
						   Dense
						   ShowToolbar="false"
						   ShowPagination="false"
						   Label="What the input holds">
					<MokaColumn TItem="InspectedItem" Title="#" Field="@(item => item.Number)" Width="44px" Mono />
					<MokaColumn TItem="InspectedItem" Title="Kind" Field="@KindOf" Width="150px">
						<CellTemplate>
							<MokaFlexbox Direction="MokaDirection.Row" Align="MokaAlign.Center" Gap="MokaSpacingScale.Xs">
								<MokaStatusDot Size="MokaSize.Xs" Color="@DotOf(context)" Glow="@GlowOf(context)" />
								<span>@KindOf(context)</span>
							</MokaFlexbox>
						</CellTemplate>
					</MokaColumn>
					<MokaColumn TItem="InspectedItem" Title="Item" Field="@(item => item.Title)">
						<CellTemplate>
							<CellLines Text="@context.Title" Detail="@context.Subtitle" />
						</CellTemplate>
					</MokaColumn>
					<MokaColumn TItem="InspectedItem" Title="Format" Field="@(item => item.Format)" Width="110px" Mono />
					<MokaColumn TItem="InspectedItem" Title="Left or key" Field="@EndOf" Width="140px" Mono Align="MokaTextAlign.Right" />
				</MokaTable>
			</MokaCard>

			@if (_inspection.Chain is { } chain)
			{
				<MokaCard Inner Title="Chain" Subtitle="@chain.Summary">
					<ChainView Certificates="Certificates" Check="chain" Label="The bundle's certificates, in the order given" />
				</MokaCard>
			}
		}
		else if (_input.IsEmpty)
		{
			<MokaEmptyState Icon="CertificateIcons.Certificate"
							Title="Nothing to inspect yet"
							Description="Paste a certificate, a chain, a key or a signing request, or open a file. Everything is read here and nothing is sent anywhere." />
		}

		@if (Selected is { } item)
		{
			<MokaCard Outlined Title="@item.Title" Subtitle="@($"Item {item.Number}, {item.Format}")">
				<HeaderActions>
					<IconButton Icon="MokaIcons.Navigation.Close" Label="Close the details" Size="MokaSize.Xs" Position="MokaTooltipPosition.BottomEnd" OnClick="CloseDetail" />
				</HeaderActions>
				<ChildContent>
					@if (item.Certificate is { } certificate)
					{
						<MokaFlexbox Gap="MokaSpacingScale.Md">
							@if (item.Matches.Count > 0)
							{
								<MokaCallout Type="MokaCalloutType.Note" Title="Belongs with">
									@foreach (string match in item.Matches)
									{
										<MokaText Element="p" Size="MokaSize.Sm">@match</MokaText>
									}
								</MokaCallout>
							}
							<CertificateDetails Info="certificate" />
						</MokaFlexbox>
					}
					else if (item.Request is { } request)
					{
						<RequestDetails Info="request" />
					}
					else if (item.Key is { } key)
					{
						<KeyDetails Info="key" Private="@(item.Kind == MaterialKind.PrivateKey)" Format="@item.Format" PublicKeyPem="@item.PublicKeyPem" Matches="item.Matches" />
					}
					else if (item.Locked)
					{
						<MokaAlert Severity="MokaToastSeverity.Info" Dense>Encrypted with @item.Subtitle. Enter its password above and press Open.</MokaAlert>
					}
				</ChildContent>
			</MokaCard>
		}
	</MokaFlexbox>
</ToolPageFrame>
