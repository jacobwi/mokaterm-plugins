@inherits CertificateViewBase
@using Moka.Certificates.Tls

<ToolPageFrame Title="Check a server"
			   Summary="@Summary"
			   Loaded="true"
			   Loading="_busy"
			   PrimaryText="@(Unavailable(Environment) is null ? "Check" : null)"
			   PrimaryIcon="CertificateIcons.Server"
			   PrimaryDisabled="_busy"
			   OnPrimary="CheckAsync">
	<MokaFlexbox Gap="MokaSpacingScale.Md">
		@if (Unavailable(Environment) is { } reason)
		{
			<MokaEmptyState Icon="CertificateIcons.Server" Title="Only in the desktop app" Description="@reason" />
		}
		else
		{
			<div @onkeydown="OnKeyAsync">
				<MokaCard Inner Outlined Title="Server" Subtitle="@($"One handshake from this machine for the chain, then one short handshake per TLS version to learn which the server takes: nothing is sent after them, no client certificate, no retry. Revocation is not checked. Each gives up after {Settings.ServerCheckTimeoutSeconds} s.")">
					<MokaFlexbox Gap="MokaSpacingScale.Md">
						<MokaFieldWrapper Label="TLS starts" HelperText="@ModeHelp" Size="MokaSize.Sm" CustomControl>
							<EnumSegmentedControl TEnum="StartTlsMode" Value="_mode" ValueChanged="@(value => _mode = value)" Options="Modes" AriaLabel="Where TLS starts" Disabled="_busy" />
						</MokaFieldWrapper>
						<MokaGrid MinColumn="12rem" Gap="MokaSpacingScale.Sm">
							<MokaTextField Label="Host" Value="@_host" ValueChanged="@(value => _host = value ?? "")" Placeholder="example.com or https://example.com:8443" Size="MokaSize.Sm" spellcheck="false" autocomplete="off" />
							<MokaTextField Label="Port" Value="@_port" ValueChanged="@(value => _port = value ?? "")" Placeholder="@PortPlaceholder" Size="MokaSize.Sm" inputmode="numeric" autocomplete="off" />
							<MokaTextField Label="SNI name" Value="@_serverName" ValueChanged="@(value => _serverName = value ?? "")" Placeholder="the host" Size="MokaSize.Sm" spellcheck="false" autocomplete="off" />
						</MokaGrid>
					</MokaFlexbox>
				</MokaCard>
			</div>

			@if (_error is { } error)
			{
				<MokaAlert Severity="MokaToastSeverity.Error" Dense>@error</MokaAlert>
			}

			@if (_report is { } report)
			{
				<ServerReport Report="report" OnInspect="OnInspect" />
			}
		}
	</MokaFlexbox>
</ToolPageFrame>
