@* The reader's notes and an operation's own: a failure as an alert, anything else as a callout to read. *@
@foreach (ReadNote note in Notes)
{
	@if (note.Level == NoteLevel.Error)
	{
		<MokaAlert Severity="MokaToastSeverity.Error" Dense>@note.Message</MokaAlert>
	}
	else
	{
		<MokaCallout Type="@(note.Level == NoteLevel.Warning ? MokaCalloutType.Warning : MokaCalloutType.Note)">@note.Message</MokaCallout>
	}
}

@code {
	[Parameter, EditorRequired]
	public IReadOnlyList<ReadNote> Notes { get; set; } = [];
}
