@inherits CertificateViewBase

@* One result: text (PEM, a signature, decrypted content) with copy and save, or a binary file with save. A secret stays
   hidden until shown and is copied through the host's secret copy, which clears the clipboard again; anything else
   copies through the host's clipboard too, never through Moka's own copy button. *@
<MokaCard Inner Outlined Title="@Title" Subtitle="@Detail">
	<HeaderActions>
		<ActionRow>
			@if (Secret)
			{
				<MokaTag Text="Secret" Color="MokaColor.Primary" Size="MokaSize.Xs" />
			}
			@Actions
			@if (Text is { } text)
			{
				@if (Secret)
				{
					<IconButton Icon="@(_shown ? MokaIcons.Toggle.EyeOff : MokaIcons.Toggle.Eye)"
								Label="@(_shown ? $"Hide the {Lower(CopyName ?? Title)}" : $"Show the {Lower(CopyName ?? Title)}")"
								Size="MokaSize.Xs"
								Pressed="_shown"
								OnClick="ToggleShown" />
					<IconButton Icon="MokaIcons.Content.Copy"
								Label="@($"Copy the {Lower(CopyName ?? Title)}")"
								Color="MokaColor.Primary"
								Size="MokaSize.Xs"
								OnClick="@(() => CopySecretAsync(text, CopyName ?? Title))" />
				}
				else
				{
					<CopyButton Text="@text" Label="@($"Copy the {Lower(CopyName ?? Title)}")" />
				}
				@if (FileName is { } name)
				{
					<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Xs" StartIcon="MokatermIcons.Download" OnClick="@(() => SaveTextAsync(name, text))">Save</MokaButton>
				}
			}
			@if (Bytes is { } bytes && BytesFileName is { } bytesName)
			{
				<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Xs" StartIcon="MokatermIcons.Download" OnClick="@(() => SaveAsync(bytesName, bytes))">@BytesLabel</MokaButton>
			}
		</ActionRow>
	</HeaderActions>
	<ChildContent>
		@if (Text is { } body)
		{
			@if (Secret && !_shown)
			{
				<MokaText Element="p" Size="MokaSize.Xs">Hidden. Copy it, save it, or show it here.</MokaText>
			}
			else
			{
				<MokaCodeBlock Code="@body" ShowCopyButton="false" ShowLineNumbers="false" Wrap MaxHeight="@MaxHeight" />
			}
		}
		@ChildContent
	</ChildContent>
</MokaCard>

@code {
	private bool _shown;

	[Parameter, EditorRequired]
	public string Title { get; set; } = "";

	/// <summary>A short note under the title, such as "3 certificates" or "RSA 2048".</summary>
	[Parameter]
	public string? Detail { get; set; }

	[Parameter]
	public string? Text { get; set; }

	/// <summary>The name Save offers for the text; null shows no Save.</summary>
	[Parameter]
	public string? FileName { get; set; }

	/// <summary>A binary form to save, such as DER or PFX; needs <see cref="BytesFileName"/>.</summary>
	[Parameter]
	public byte[]? Bytes { get; set; }

	[Parameter]
	public string? BytesFileName { get; set; }

	[Parameter]
	public string BytesLabel { get; set; } = "Save file";

	/// <summary>A private key or decrypted content: hidden until shown, copied as a secret.</summary>
	[Parameter]
	public bool Secret { get; set; }

	/// <summary>What the copy button and its notice call it: "Private key", "Chain".</summary>
	[Parameter]
	public string? CopyName { get; set; }

	[Parameter]
	public string MaxHeight { get; set; } = "320px";

	/// <summary>Buttons of the caller's own, drawn before copy and save.</summary>
	[Parameter]
	public RenderFragment? Actions { get; set; }

	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	private static string Lower(string name) => name.Length > 1 && char.IsUpper(name[0]) && !char.IsUpper(name[1])
		? char.ToLowerInvariant(name[0]) + name[1..]
		: name;

	private void ToggleShown() => _shown = !_shown;
}
