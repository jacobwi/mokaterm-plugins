@inherits CertificateViewBase

@* A paste area with "Open file" in a card: text stays in the box to edit, a binary file (DER, PFX) shows as its name and
   size instead. Fields that belong with it, such as its password, go in as child content. *@
<div class="mc-input">
	<MokaCard Inner Outlined Title="@Label" Subtitle="@Hint">
		<HeaderActions>
			<ActionRow>
				@if (AllowFile)
				{
					<MokaButton Variant="MokaVariant.Text"
								Color="MokaColor.Surface"
								Size="MokaSize.Xs"
								StartIcon="MokatermIcons.FolderOpen"
								Disabled="Disabled"
								OnClick="OpenAsync">
						Open file
					</MokaButton>
				}
				@if (!Value.IsEmpty)
				{
					<MokaButton Variant="MokaVariant.Text"
								Color="MokaColor.Surface"
								Size="MokaSize.Xs"
								StartIcon="MokaIcons.Navigation.Close"
								Disabled="Disabled"
								OnClick="ClearAsync">
						Clear
					</MokaButton>
				}
			</ActionRow>
		</HeaderActions>
		<ChildContent>
			<MokaFlexbox Gap="MokaSpacingScale.Sm">
				@if (Value.Bytes is { } bytes)
				{
					<MokaFlexbox Direction="MokaDirection.Row" Align="MokaAlign.Center" Gap="MokaSpacingScale.Sm">
						<MokaIcon Icon="CertificateIcons.File" Size="MokaSize.Sm" />
						<MokaText Element="span" Size="MokaSize.Xs" Mono Truncate title="@Value.FileName">@Value.FileName</MokaText>
						<MokaTag Text="@Size(bytes.Length)" Color="MokaColor.Surface" Size="MokaSize.Xs" />
					</MokaFlexbox>
				}
				else
				{
					<MokaTextArea Value="@Value.Text"
								  ValueChanged="OnTextChangedAsync"
								  Rows="Rows"
								  Placeholder="@Placeholder"
								  DebounceDelay="250"
								  Disabled="Disabled"
								  Size="MokaSize.Sm"
								  Mono
								  spellcheck="false"
								  autocomplete="off"
								  aria-label="@Label" />
				}
				@ChildContent
			</MokaFlexbox>
		</ChildContent>
	</MokaCard>
</div>

@code {
	[Parameter, EditorRequired]
	public string Label { get; set; } = "";

	[Parameter]
	public InputContent Value { get; set; } = InputContent.Empty;

	[Parameter]
	public EventCallback<InputContent> ValueChanged { get; set; }

	[Parameter]
	public string? Placeholder { get; set; }

	/// <summary>A sentence under the title, about what goes in the box.</summary>
	[Parameter]
	public string? Hint { get; set; }

	[Parameter]
	public int Rows { get; set; } = 6;

	[Parameter]
	public bool AllowFile { get; set; } = true;

	/// <summary>What the file should be, for the message when it is too large: "a certificate or a key".</summary>
	[Parameter]
	public string FileWhat { get; set; } = "a certificate or a key";

	/// <summary>Keeps any opened file as bytes, for data to sign or encrypt, instead of reading text files into the box.</summary>
	[Parameter]
	public bool KeepFilesAsBytes { get; set; }

	[Parameter]
	public bool Disabled { get; set; }

	/// <summary>Fields that go with the input, such as its password, under the box.</summary>
	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	private static string Size(int bytes) => bytes < 1024
		? string.Create(CultureInfo.CurrentCulture, $"{bytes} bytes")
		: string.Create(CultureInfo.CurrentCulture, $"{bytes / 1024.0:0.#} KB");

	private Task OnTextChangedAsync(string? text) => ValueChanged.InvokeAsync(new InputContent { Text = text ?? "" });

	private Task ClearAsync() => ValueChanged.InvokeAsync(InputContent.Empty);

	private async Task OpenAsync()
	{
		if (await OpenFileAsync(FileWhat) is not { } file)
		{
			return;
		}

		string? text = KeepFilesAsBytes ? null : CryptoInput.TryReadText(file.Bytes);
		await ValueChanged.InvokeAsync(text is null
			? new InputContent { Bytes = file.Bytes, FileName = file.Name }
			: new InputContent { Text = text, FileName = file.Name });
	}
}
