@inherits CertificateViewBase

@* A private or public key, described by its public half. A private key itself is never shown here: Convert writes it out. *@
<MokaFlexbox Gap="MokaSpacingScale.Md">
	<MokaFlexbox Direction="MokaDirection.Row" Align="MokaAlign.Center" Gap="MokaSpacingScale.Xs" Wrap>
		<MokaTag Text="@(Private ? "Private key" : "Public key")" Color="@(Private ? MokaColor.Primary : MokaColor.Surface)" />
		@if (!Info.Usable)
		{
			<Hint Text="@Info.Limitation">
				<MokaTag Text="Not usable here" Color="MokaColor.Warning" />
			</Hint>
		}
	</MokaFlexbox>

	<MokaGrid MinColumn="9rem" Gap="MokaSpacingScale.Sm">
		<MokaStat Tile Value="@Info.Algorithm" Label="Algorithm" Color="@(Info.Usable ? null : MokaColor.Warning)" />
		<MokaStat Tile Value="@SizeValue" Label="@SizeLabel" />
		<MokaStat Tile Value="@(Format ?? "Unknown")" Label="Stored as" />
	</MokaGrid>

	@if (Info.Limitation is { } limitation)
	{
		<MokaCallout Type="MokaCalloutType.Warning" Title="Not usable here">@limitation</MokaCallout>
	}

	@if (Matches.Count > 0)
	{
		<MokaCallout Type="MokaCalloutType.Note" Title="Belongs with">
			@foreach (string match in Matches)
			{
				<MokaText Element="p" Size="MokaSize.Sm">@match</MokaText>
			}
		</MokaCallout>
	}

	<FactCard Title="Fingerprints" Items="KeyFacts">
		<Actions>
			<MokaButton Variant="MokaVariant.Text" Color="MokaColor.Surface" Size="MokaSize.Xs" OnClick="@(() => SaveTextAsync("key.json", CertificateReport.Json(Info)))">Save JSON</MokaButton>
		</Actions>
	</FactCard>

	@if (PublicKeyPem is { } pem)
	{
		<OutputCard Title="Public key" Detail="@Info.Description" Text="@pem" FileName="public-key.pem" CopyName="Public key" />
	}
</MokaFlexbox>

@code {
	[Parameter, EditorRequired]
	public KeyInfo Info { get; set; } = default!;

	[Parameter]
	public bool Private { get; set; }

	[Parameter]
	public string? Format { get; set; }

	[Parameter]
	public string? PublicKeyPem { get; set; }

	[Parameter]
	public IReadOnlyList<string> Matches { get; set; } = [];

	private string SizeValue => Info switch
	{
		{ Curve: { } curve } => curve,
		{ Bits: { } bits } => bits.ToString("N0", CultureInfo.CurrentCulture),
		_ => "Not stated",
	};

	private string SizeLabel => Info switch
	{
		{ Curve: not null } => "Curve",
		{ Bits: not null } => "Bits",
		_ => "Size",
	};

	private IReadOnlyList<MokaDataListItem> KeyFacts =>
	[
		Facts.Text("Key", Info.Description),
		Facts.Mono("Key SHA-256", Info.SpkiSha256, "Copy the key's SHA-256"),
		Facts.Mono("Key pin", Info.Pin, "Copy the key pin"),
	];
}
