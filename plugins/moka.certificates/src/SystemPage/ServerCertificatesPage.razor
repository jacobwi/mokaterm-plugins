@inherits SystemPageBase
@using Moka.Certificates.ServerFiles

@* A System view page on the shared frame and detail panel, so it reads like the pages around it. A certificate's
   details are the tool's own component. *@
<ToolPageFrame Title="Certificates"
			   Summary="@Summary"
			   Search="@_filter"
			   SearchChanged="OnFilterChanged"
			   SearchPlaceholder="Filter by name, issuer or path"
			   PrimaryText="@(HasCertbot ? "Test renewal" : null)"
			   PrimaryIcon="MokatermIcons.Reconnect"
			   PrimaryDisabled="@(Busy || Context.RootChangeBlocked is not null)"
			   PrimaryTitle="@(Context.RootChangeBlocked ?? "certbot renew --dry-run for every certificate")"
			   OnPrimary="TestAllAsync"
			   Loading="Loading"
			   Loaded="Loaded"
			   Error="@LoadError"
			   OnRefresh="ReloadAsync"
			   ListPage
			   Detail="@(Selected is null ? null : DetailPanel)">
	<div class="mc-files">
		<MokaFlexbox Gap="MokaSpacingScale.Md">
			@if (RootHint is { } hint)
			{
				<MokaCallout Type="MokaCalloutType.Note" Title="Root mode reads more">
					<FixAction>
						@if (!Context.RootModeOn)
						{
							<Hint Text="@Context.RootChangeBlocked">
								<MokaButton Variant="MokaVariant.Outlined"
											Size="MokaSize.Xs"
											StartIcon="MokatermIcons.Root"
											Disabled="@(Context.RootChangeBlocked is not null)"
											OnClick="EnableRootAsync">
									Root mode
								</MokaButton>
							</Hint>
						}
					</FixAction>
					<ChildContent>@hint</ChildContent>
				</MokaCallout>
			}

			@foreach (string skipped in _discovery.Skipped)
			{
				<MokaAlert Severity="MokaToastSeverity.Warning" Dense>@skipped</MokaAlert>
			}

			@if (_files.Count > 0)
			{
				<MokaGrid MinColumn="7rem" Gap="MokaSpacingScale.Sm">
					@foreach ((string label, int count, MokaColor? color) in Counts)
					{
						<MokaStat Tile Value="@count.ToString(CultureInfo.CurrentCulture)" Label="@label" Color="@(count > 0 ? color : null)" />
					}
				</MokaGrid>
			}

			<MokaTable TItem="ServerCertificateFile"
					   Items="_shown"
					   ItemKey="@(file => file.Path)"
					   SelectedItems="SelectedSet"
					   OnRowClick="Select"
					   Dense
					   ShowToolbar="false"
					   ShowPagination="false"
					   Label="Certificates on the server"
					   EmptyIcon="CertificateIcons.Certificate"
					   EmptyTitle="@(_files.Count == 0 ? "No certificates found" : "Nothing matches")"
					   EmptyText="@(_files.Count == 0 ? LookedIn : "No certificate's names, issuer or path match the filter.")">
				<MokaColumn TItem="ServerCertificateFile" Title="Certificate" Field="@TitleOf">
					<CellTemplate>
						<MokaFlexbox Direction="MokaDirection.Row" Align="MokaAlign.Center" Gap="MokaSpacingScale.Sm">
							<MokaStatusDot Size="MokaSize.Xs" Color="@DotOf(context)" Glow="@GlowOf(context)" />
							<CellLines Text="@TitleOf(context)" Detail="@context.Path" DetailMono />
						</MokaFlexbox>
					</CellTemplate>
				</MokaColumn>
				<MokaColumn TItem="ServerCertificateFile" Title="Issuer" Field="@(file => file.Leaf?.IssuerTitle ?? "")" Class="mc-col-wide">
					<CellTemplate>@(context.Leaf?.IssuerTitle ?? "-")</CellTemplate>
				</MokaColumn>
				<MokaColumn TItem="ServerCertificateFile" Title="Expires" Field="@(file => file.Leaf?.NotAfter)" Width="104px" Mono>
					<CellTemplate>@ExpiresOf(context)</CellTemplate>
				</MokaColumn>
				<MokaColumn TItem="ServerCertificateFile" Title="Used by" Field="@UsedBy" Class="mc-col-wide" />
			</MokaTable>
		</MokaFlexbox>
	</div>
</ToolPageFrame>

@code {
	private RenderFragment DetailPanel => @<text>
		@if (Selected is { } file)
		{
			<ToolDetailPanel Title="@TitleOf(file)"
							 Subtitle="@file.Path"
							 DotColor="@DotOf(file)"
							 DotGlow="@GlowOf(file)"
							 OnClose="CloseDetail">
				<Actions>
					@if (file.Lineage is { } lineage && HasCertbot)
					{
						<Hint Text="@Context.RootChangeBlocked">
							<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Xs" Disabled="@(Busy || Context.RootChangeBlocked is not null)" OnClick="@(() => TestOneAsync(lineage.Name))">Test renewal</MokaButton>
						</Hint>
						<Hint Text="@Context.RootChangeBlocked">
							<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Xs" Disabled="@(Busy || Context.RootChangeBlocked is not null)" OnClick="@(() => RenewAsync(lineage.Name))">Renew</MokaButton>
						</Hint>
					}
					@if (UsedByNginx(file) && Context.Server.HasCommand(ServerCertificateCommands.Nginx))
					{
						<Hint Text="@Context.RootChangeBlocked">
							<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Xs" Disabled="@(Busy || Context.RootChangeBlocked is not null)" OnClick="ReloadNginxAsync">Reload nginx</MokaButton>
						</Hint>
					}
					@if (UsedByApache(file) && ServerCertificateCommands.ReloadApache(Context.Server) is not null)
					{
						<Hint Text="@Context.RootChangeBlocked">
							<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Xs" Disabled="@(Busy || Context.RootChangeBlocked is not null)" OnClick="ReloadApacheAsync">Reload Apache</MokaButton>
						</Hint>
					}
				</Actions>
				<ChildContent>
					<ServerFileDetails File="file" />
				</ChildContent>
			</ToolDetailPanel>
		}
	</text>;
}
