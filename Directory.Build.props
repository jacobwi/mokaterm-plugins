<Project>

	<!-- The same rules as Mokaterm itself: a plugin is held to the code standard of the app it runs in. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<AnalysisLevel>latest</AnalysisLevel>
		<AnalysisMode>Recommended</AnalysisMode>
		<Deterministic>true</Deterministic>
		<Authors>Moka</Authors>
		<Company>Moka</Company>
		<Copyright>Copyright (c) Moka 2026</Copyright>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!--
		CA2007: ConfigureAwait is noise in Blazor components and services that never block on tasks.
		CA1515: plugin types are public because components and the module are found by the host.
		CA1848/CA1873: LoggerMessage delegates for every log call; the arguments are cheap.
		CA1062: nullable reference types already cover argument null checks.
		CA1812: the host constructs internal services through DI, which the analyzer cannot see.
		CA1819: crypto records expose byte arrays on purpose.
	-->
	<PropertyGroup>
		<NoWarn>$(NoWarn);CA2007;CA1515;CA1848;CA1873;CA1062;CA1812;CA1819</NoWarn>
	</PropertyGroup>

</Project>
