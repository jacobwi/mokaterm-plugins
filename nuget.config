<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!--
		Mokaterm's own packages come from .feed, which build/mokaterm_feed.py fills (built from a Mokaterm checkout until
		the version in mokaterm.json is on nuget.org); everything else comes from nuget.org. Run the script before the
		first restore.
	-->
	<!-- Stamped Mokaterm builds are new versions every time; keeping them out of the machine-wide NuGet cache. -->
	<config>
		<add key="globalPackagesFolder" value=".work/packages" />
	</config>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
		<add key="mokaterm-local" value=".feed" />
	</packageSources>
	<packageSourceMapping>
		<packageSource key="mokaterm-local">
			<package pattern="Mokaterm.*" />
		</packageSource>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>
</configuration>
